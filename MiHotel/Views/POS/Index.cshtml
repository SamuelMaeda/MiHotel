@{
    ViewData["Title"] = "Punto de Venta";

    var productos = ViewBag.Productos as System.Data.DataTable;
    var clientes = ViewBag.Clientes as System.Data.DataTable;
    var reservas = ViewBag.Reservas as System.Data.DataTable;
    ViewData["SeccionOperativa"] = "punto-venta";
}

<style>
    .tarjeta-contenido {
        background-color: white;
        border-radius: 15px;
        padding: 25px;
        box-shadow: 0 4px 10px rgba(0,0,0,0.10);
        margin-bottom: 20px;
        height: 100%;
        max-width: 1000px;
    }

    /* TITULOS (ENCAPSULADOS) */
    .pos-container h4 {
        font-size: 20px;
        font-weight: 600;
        margin-bottom: 15px;
        color: #212529;
    }

    .pos-container h5 {
        font-size: 18px;
        font-weight: 600;
        color: #212529;
    }

    /* LABELS (ENCAPSULADOS) */
    .pos-container label {
        font-weight: 600;
        color: #363636;
        margin-bottom: 6px;
        display: block;
        font-size: 15px;
    }

    .form-control-custom {
        background-color: #f8f9fa;
        border: 1px solid #dee2e6;
        border-radius: 8px;
        padding: 10px 12px;
        height: 44px;
        width: 100%;
        font-size: 15px;
        display: flex;
        align-items: center;
    }

    .btn-agregar {
        background-color: #4a7c59;
        color: white;
        border: none;
        padding: 8px 14px;
        border-radius: 8px;
    }

    .btn-guardar {
        background-color: #4a7c59;
        color: white;
        border: none;
        padding: 10px 18px;
        border-radius: 8px;
        margin-top: 20px;
    }

    .btn-cantidad {
        padding: 4px 10px;
        border: none;
        border-radius: 6px;
        background-color: #dee2e6;
        margin: 0 3px;
        font-size: 13px;
    }

    .btn-eliminar {
        background-color: #dc3545;
        color: white;
        border: none;
        padding: 5px 10px;
        border-radius: 6px;
        font-size: 13px;
    }

    .tabla-pos {
        width: 100%;
        table-layout: fixed;
        margin-top: 10px;
    }

        .tabla-pos th {
            background-color: #212529;
            color: white;
            text-align: center;
            font-size: 15px;
            font-weight: 600;
            padding: 10px;
        }

        .tabla-pos td {
            text-align: center;
            vertical-align: middle;
            font-size: 15px;
            padding: 10px;
        }

    #total {
        font-weight: bold;
    }

    .mensaje-pos-exito {
        background-color: #dff3e3;
        border: 1px solid #b7dfc0;
        color: #1f5130;
        border-radius: 12px;
        padding: 14px 18px;
        margin-bottom: 20px;
        box-shadow: 0 2px 6px rgba(0,0,0,0.06);
    }

        .mensaje-pos-exito strong {
            display: block;
            font-size: 15px;
            margin-bottom: 2px;
        }

        .mensaje-pos-exito span {
            font-size: 13px;
            color: #45634f;
        }

    .form-control-custom[readonly] {
        background-color: #e9ecef;
        color: #495057;
        cursor: not-allowed;
        font-weight: 500;
    }

    .buscador-pos {
        margin-bottom: 10px;
    }

    /* EXTRA */

    .contenedor-autocomplete {
        position: relative;
    }

    .lista-sugerencias {
        position: absolute;
        top: 100%;
        left: 0;
        right: 0;
        background-color: white;
        border: 1px solid #dee2e6;
        border-top: none;
        border-radius: 0 0 8px 8px;
        box-shadow: 0 4px 10px rgba(0,0,0,0.08);
        max-height: 220px;
        overflow-y: auto;
        z-index: 50;
        display: none;
    }

    .item-sugerencia {
        padding: 10px 12px;
        cursor: pointer;
        border-bottom: 1px solid #f1f1f1;
        font-size: 15px;
    }

        .item-sugerencia:hover {
            background-color: #f8f9fa;
        }

    .texto-sin-resultados {
        padding: 10px 12px;
        color: #6c757d;
        font-size: 14px;
    }

</style>

<div class="pos-container mh-page-shell">
    <div class="mh-page-header">
        <div>
            <h3>Punto de Venta</h3>
            <p>Registre productos y servicios consumidos por huéspedes o clientes.</p>
        </div>
    </div>

    <partial name="~/Views/Shared/_NavegacionOperativa.cshtml" />

    @if (TempData["Exito"] != null)
    {
        <div class="mensaje-pos-exito">
            <strong>@TempData["Exito"]</strong>
            <span>La transacción fue procesada y almacenada correctamente.</span>
        </div>
    }

    <div class="row">

        <!-- ========================= -->
        <!-- AGREGAR PRODUCTO -->
        <!-- ========================= -->
        <div class="col-md-5">
            <div class="tarjeta-contenido">

                <h4>Agregar Producto</h4>

                <div>
                    <label>Habitación</label>

                    <select id="reserva"
                            class="form-control-custom"
                            onchange="cargarDatosReserva()">

                        <option value="">Sin habitación</option>

                        @foreach (System.Data.DataRow r in reservas.Rows)
                        {
                            <option value="@r["id_reserva"]"
                                    data-cliente="@r["id_clipro"]"
                                    data-nombrecliente="@r["cliente"]">

                                @r["habitacion"] - @r["cliente"]

                            </option>
                        }

                    </select>
                </div>

                <div id="contenedorClienteAsignado" style="margin-top:10px; display:none;">

                    <label>Cliente asignado</label>

                    <input type="text"
                           id="clienteVisual"
                           class="form-control-custom"
                           readonly />
                </div>

                <div id="contenedorClienteManual" style="margin-top:10px; display:none;">

                    <label>Cliente</label>

                    <div class="contenedor-autocomplete">

                        <input type="text"
                               id="buscarCliente"
                               class="form-control-custom"
                               placeholder="Buscar cliente o dejar vacío para consumidor final..."
                               autocomplete="off" />

                        <div id="listaClientes" class="lista-sugerencias"></div>

                        <select id="cliente" style="display:none;">

                            <option value="">Consumidor final</option>

                            @foreach (System.Data.DataRow c in clientes.Rows)
                            {
                                <option value="@c["id_clipro"]">
                                    @c["nombre"]
                                </option>
                            }

                        </select>

                    </div>
                </div>

                <hr />

                <div>
                    <label>Producto</label>
                        <div class="contenedor-autocomplete">

                            <input type="text"
                                   id="buscarProducto"
                                   class="form-control-custom"
                                   placeholder="Buscar producto..."
                                   autocomplete="off" />

                            <div id="listaProductos" class="lista-sugerencias"></div>
                    <select id="producto"
                            onchange="cargarProducto()"
                            style="display:none;">
                            <option value="" disabled selected hidden>
                                Seleccione un producto
                            </option>
                        @foreach (System.Data.DataRow p in productos.Rows)
                        {
                                <option value="@p["id_proser"]"
                                        data-precio="@p["precio"]"
                                        data-stock="@p["stock"]"
                                        data-tipo="@p["tipo"]">
                                    @p["nombre_proser"]
                                </option>
                        }
                    </select>
                </div>
                </div>

                <div style="margin-top:10px;">
                    <label>Precio</label>
                    <input type="text" id="precio" class="form-control-custom" readonly />
                </div>

                <div style="margin-top:10px;">
                    <label>Stock</label>
                    <input type="text" id="stock" class="form-control-custom" readonly />
                </div>

                <div style="margin-top:10px;">
                    <label>Cantidad</label>
                    <input type="number" id="cantidad" class="form-control-custom" min="1" />
                </div>

                <div style="margin-top:15px;">
                    <button type="button" class="btn-agregar" onclick="agregarProducto()">
                        + Agregar
                    </button>
                </div>

            </div>
        </div>

        <!-- ========================= -->
        <!-- CARRITO -->
        <!-- ========================= -->
        <div class="col-md-7">
            <div class="tarjeta-contenido">

                <h4>Carrito de Compra</h4>

                <table class="table tabla-pos">
                    <thead>
                        <tr>
                            <th>Producto</th>
                            <th>Cant</th>
                            <th>Precio</th>
                            <th>Subtotal</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody id="carrito">
                        <tr>
                            <td colspan="5" style="text-align:center; padding:15px;">
                                No se han ingresado productos dentro del carrito de compra
                            </td>
                        </tr>
                    </tbody>
                </table>

                <h5>Total: Q <span id="total">0.00</span></h5>

                <div style="margin-top:15px;">
                    <label>Monto pagado</label>
                    <input type="number" id="montoPagado" class="form-control-custom" step="0.01" value="0" />
                </div>

                <form method="post" asp-action="GuardarVenta">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="detalleJson" id="detalleJson" />
                    <input type="hidden" name="id_clipro" id="inputCliente" />
                    <input type="hidden" name="id_reserva" id="inputReserva" />
                    <input type="hidden" name="montoPagado" id="inputPagado" />

                    <button type="submit" class="btn-guardar" style="margin-top:20px;" onclick="preparar()">
                        Confirmar Venta
                    </button>
                </form>

            </div>
        </div>

    </div>

</div>

<script>
    let carrito = [];
                    document.addEventListener("DOMContentLoaded", function () {

                configurarAutocomplete(
                    "buscarCliente",
                    "listaClientes",
                    "cliente",
                    null
                );

                configurarAutocomplete(
                    "buscarProducto",
                    "listaProductos",
                    "producto",
                    cargarProducto
                );

                cargarDatosReserva();
    });

                       function cargarDatosReserva() {

        let reserva = document.getElementById("reserva");

        let option = reserva.options[reserva.selectedIndex];

        let cliente = option.getAttribute("data-nombrecliente");

        let contenedorAsignado =
            document.getElementById("contenedorClienteAsignado");

        let contenedorManual =
            document.getElementById("contenedorClienteManual");

        // SIN HABITACIÓN
        if (reserva.value === "") {

            contenedorAsignado.style.display = "none";

            contenedorManual.style.display = "block";

            document.getElementById("buscarCliente").value = "";
            document.getElementById("cliente").value = "";

            return;
        }

        // CON HABITACIÓN
        contenedorManual.style.display = "none";

        contenedorAsignado.style.display = "block";

        document.getElementById("clienteVisual").value = cliente;
    }

            function configurarAutocomplete(inputId, listaId, selectId, callback) {

                const input = document.getElementById(inputId);
                const lista = document.getElementById(listaId);
                const select = document.getElementById(selectId);

                input.addEventListener("input", function () {

                    lista.innerHTML = "";

                    const texto = input.value.trim().toLowerCase();

                    if (texto === "") {
                        lista.style.display = "none";
                        return;
                    }

                    let coincidencias = 0;

                    for (let option of select.options) {

                        if (option.value === "") continue;

                        const contenido = option.text.toLowerCase();

                        if (contenido.includes(texto)) {

                            coincidencias++;

                            const item = document.createElement("div");

                            item.className = "item-sugerencia";
                            item.textContent = option.text;

                            item.addEventListener("click", function () {

                                input.value = option.text;
                                select.value = option.value;

                                lista.style.display = "none";

                                if (callback) {
                                    callback();
                                }
                            });

                            lista.appendChild(item);
                        }
                    }

                    if (coincidencias === 0) {

                        const vacio = document.createElement("div");

                        vacio.className = "texto-sin-resultados";
                        vacio.textContent = "No se encontraron resultados.";

                        lista.appendChild(vacio);
                    }

                    lista.style.display = "block";
                });

                document.addEventListener("click", function (e) {

                    if (!lista.contains(e.target) && e.target !== input) {
                        lista.style.display = "none";
                    }
                });
            }

            

          



       function cargarProducto() {

        let select = document.getElementById("producto");
        if (!select.value) return;
        let option = select.options[select.selectedIndex];
       

        let precio = option.getAttribute("data-precio") || "";
        let stock = option.getAttribute("data-stock") || "";
        let tipo = option.getAttribute("data-tipo") || "";

        document.getElementById("precio").value = precio;

        // PRODUCTO
        if (tipo.toLowerCase() === "producto") {

            document.getElementById("stock").value = stock;
        }

        // SERVICIO
        else {

            document.getElementById("stock").value = "No aplica";
        }
    }

        function agregarProducto() {

        let select = document.getElementById("producto");
        let option = select.options[select.selectedIndex];

        let tipo = option.getAttribute("data-tipo");
        let stock = parseInt(option.getAttribute("data-stock")) || 0;

        let id = parseInt(select.value);
        let nombre = option.text;
        let precio = parseFloat(document.getElementById("precio").value);
        let cantidad = parseInt(document.getElementById("cantidad").value);

        if (!id || !cantidad || cantidad <= 0) return;

        let item = carrito.find(p => p.id == id);

        if (item) {

            // PRODUCTO
            if (tipo.toLowerCase() === "producto") {

                if (item.cantidad + cantidad > stock) {
                    alert("Stock insuficiente");
                    return;
                }
            }

            item.cantidad += cantidad;
        }
        else {

            // PRODUCTO
            if (tipo.toLowerCase() === "producto") {

                if (cantidad > stock) {
                    alert("Stock insuficiente");
                    return;
                }
            }

            carrito.push({
                id,
                nombre,
                precio,
                cantidad,
                stock,
                tipo
            });
        }

        render();
    }

    function cambiarCantidad(id, delta) {
        let item = carrito.find(p => p.id == id);

        if (!item) return;

        let nuevaCantidad = item.cantidad + delta;

        if (nuevaCantidad <= 0) {
            carrito = carrito.filter(p => p.id != id);
            }
    else if (
        item.tipo.toLowerCase() === "servicio"
        || nuevaCantidad <= item.stock
    ) {

        item.cantidad = nuevaCantidad;
    }
    else {

        alert("Stock máximo alcanzado");
    }

        render();
    }

    function eliminar(id) {
        carrito = carrito.filter(p => p.id != id);
        render();
    }

    function render() {
        let html = "";
        let total = 0;

        carrito.forEach(p => {
            let sub = p.precio * p.cantidad;
            total += sub;

            html += `
            <tr>
                <td>${p.nombre}</td>
                <td>
                    <button class="btn-cantidad" onclick="cambiarCantidad(${p.id}, -1)">-</button>
                    ${p.cantidad}
                    <button class="btn-cantidad" onclick="cambiarCantidad(${p.id}, 1)">+</button>
                </td>
                <td>Q ${p.precio}</td>
                <td>Q ${sub.toFixed(2)}</td>
                <td>
                    <button class="btn-eliminar" onclick="eliminar(${p.id})">X</button>
                </td>
            </tr>`;
        });

        if (carrito.length === 0) {
            document.getElementById("carrito").innerHTML = `
                <tr>
                    <td colspan="5" style="text-align:center; padding:15px;">
                        No se han ingresado productos dentro del carrito de compra
                    </td>
                </tr>`;
            document.getElementById("total").innerText = "0.00";
            return;
        }

        document.getElementById("carrito").innerHTML = html;
        document.getElementById("total").innerText = total.toFixed(2);
    }

    function preparar() {
        document.getElementById("detalleJson").value = JSON.stringify(carrito);

        

        let reserva = document.getElementById("reserva");

    let cliente = "";

    // CON HABITACIÓN
    if (reserva.value !== "") {

        cliente = reserva.options[reserva.selectedIndex]
            .getAttribute("data-cliente");
    }

    // SIN HABITACIÓN
    else {

        cliente = document.getElementById("cliente").value;
    }

        if (reserva.value === "" && cliente === "") {
        cliente = "";
    }

    document.getElementById("inputCliente").value = cliente;

        document.getElementById("inputReserva").value = document.getElementById("reserva").value;
        document.getElementById("inputPagado").value = document.getElementById("montoPagado").value;
    }
</script>
