@model MiHotel.Models.EditarCliente
@{ ViewData["Title"] = "Editar Cliente"; }
<style>
    .tarjeta-contenido{background:#fff;border-radius:15px;padding:25px;box-shadow:0 4px 10px rgba(0,0,0,.10);max-width:1050px;margin:auto}.acciones{display:flex;gap:10px;flex-wrap:wrap;margin-top:22px}.btn-guardar,.btn-volver,.btn-eliminar{color:#fff;padding:10px 17px;border-radius:8px;border:0;text-decoration:none;font-weight:500}.btn-guardar{background:#464482}.btn-volver{background:#824B44}.btn-eliminar{background:#b4232b;font-size:13px;padding:7px 10px}.texto-opcional,.form-text{font-size:13px;color:#6c757d}.btn-catalogo{display:inline-flex;align-items:center;gap:7px;margin-top:8px;padding:8px 12px;border-radius:8px;background:#824B44;color:#fff;text-decoration:none;font-size:14px;font-weight:500}.btn-catalogo:hover{background:#6e3f39;color:#fff}.nota-imagen{color:#6c757d;font-size:13px;margin-top:-2px}.documentos-actuales{display:flex;gap:12px;flex-wrap:wrap;margin-bottom:18px}.documento-actual{border:1px solid #ddd;border-radius:10px;padding:10px;background:#fafafa}.miniatura{display:block;width:210px;height:125px;object-fit:cover;border-radius:7px;margin-bottom:8px}
</style>
<div class="container-fluid px-3 px-md-4 py-4"><div class="tarjeta-contenido">
    <h3 class="mb-3">Editar Cliente</h3>
    @if(ViewBag.Mensaje!=null){<div class="alert alert-danger">@ViewBag.Mensaje</div>}
    @if(TempData["Exito"]!=null){<div class="alert alert-success">@TempData["Exito"]</div>}
    @if(Model.TieneDpiFrente){
        <h5>Fotografía actual</h5><div class="documentos-actuales">
        @if(Model.TieneDpiFrente){<div class="documento-actual"><img class="miniatura" src="@Url.Action("DocumentoDpi",new{id=Model.IdClipro,tipo="dpi_frente"})" alt="Frente del DPI"/><form asp-action="EliminarDocumentoDpi" method="post" onsubmit="return confirm('¿Eliminar esta fotografía?');">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@Model.IdClipro"/><input type="hidden" name="tipo" value="dpi_frente"/><button class="btn-eliminar">Eliminar fotografía frontal</button></form></div>}
        </div><div class="form-text mb-3">Si selecciona una nueva fotografía, reemplazará la existente.</div>
    }
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
    <form asp-action="Editar" method="post" enctype="multipart/form-data" novalidate>
        @Html.AntiForgeryToken()<input asp-for="IdClipro" type="hidden"/><input asp-for="TieneDpiFrente" type="hidden"/>
        <partial name="_Formulario" model="Model" />
        <div class="acciones"><button class="btn-guardar" type="submit">Guardar cambios</button><a asp-action="Index" class="btn-volver">Volver al listado</a></div>
    </form>
</div></div>
@section Scripts{<partial name="_ValidationScriptsPartial"/><script>document.querySelectorAll('.campo-telefono').forEach(x=>x.addEventListener('input',()=>{let v=x.value.replace(/\D/g,'').slice(0,8);x.value=v.length>4?v.slice(0,4)+' '+v.slice(4):v;}));</script>}
