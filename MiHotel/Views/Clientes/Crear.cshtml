@model MiHotel.Models.ClienteAdmin
@{ ViewData["Title"] = "Registrar Cliente"; string? returnUrl = ViewBag.ReturnUrl as string; }
<style>
    .tarjeta-contenido{background:#fff;border-radius:15px;padding:25px;box-shadow:0 4px 10px rgba(0,0,0,.10);max-width:1050px;margin:auto}.acciones{display:flex;gap:10px;flex-wrap:wrap;margin-top:22px}.btn-guardar,.btn-volver{color:#fff;padding:10px 17px;border-radius:8px;border:0;text-decoration:none;font-weight:500}.btn-guardar{background:#464482}.btn-volver{background:#824B44}.texto-opcional,.form-text{font-size:13px;color:#6c757d}.btn-catalogo{display:inline-flex;align-items:center;gap:7px;margin-top:8px;padding:8px 12px;border-radius:8px;background:#824B44;color:#fff;text-decoration:none;font-size:14px;font-weight:500}.btn-catalogo:hover{background:#6e3f39;color:#fff}.nota-imagen{color:#6c757d;font-size:13px;margin-top:-2px}
</style>
<div class="container-fluid px-3 px-md-4 py-4"><div class="tarjeta-contenido">
    <h3 class="mb-3">Registrar Cliente</h3>
    @if(ViewBag.Mensaje!=null){<div class="alert alert-danger">@ViewBag.Mensaje</div>}
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
    <form asp-action="Crear" method="post" enctype="multipart/form-data" novalidate>
        @Html.AntiForgeryToken()
        @if(!string.IsNullOrWhiteSpace(returnUrl)){<input type="hidden" name="returnUrl" value="@returnUrl" />}
        <partial name="_Formulario" model="Model" />
        <div class="acciones"><button class="btn-guardar" type="submit">Guardar cliente</button><a href="@(returnUrl ?? Url.Action("Index","Clientes"))" class="btn-volver">Volver</a></div>
    </form>
</div></div>
@section Scripts{<partial name="_ValidationScriptsPartial"/><script>document.querySelectorAll('.campo-telefono').forEach(x=>x.addEventListener('input',()=>{let v=x.value.replace(/\D/g,'').slice(0,8);x.value=v.length>4?v.slice(0,4)+' '+v.slice(4):v;}));</script>}
