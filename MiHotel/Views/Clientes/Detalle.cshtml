@model MiHotel.Models.ClienteDetalleViewModel
@{ ViewData["Title"]="Detalle del Cliente"; string Mostrar(string? v)=>string.IsNullOrWhiteSpace(v)?"-":v; string clase=Model.CodigoClasificacion switch{"A"=>"tipo-a","C"=>"tipo-c",_=>"tipo-b"}; }
<style>
 .tarjeta{background:#fff;border-radius:15px;padding:25px;box-shadow:0 4px 10px rgba(0,0,0,.1);max-width:1050px;margin:auto}.detalle-label{font-weight:600;color:#363636;margin-bottom:5px}.detalle-valor{background:#f8f9fa;border:1px solid #dee2e6;border-radius:8px;padding:10px 12px;min-height:44px}.tipo{display:inline-block;border-radius:999px;padding:5px 12px;font-weight:700}.tipo-a{background:#d9f2df;color:#17652b}.tipo-b{background:#fff0c9;color:#885b00}.tipo-c{background:#f7d7d9;color:#8f1d26}.fotos{display:flex;gap:18px;flex-wrap:wrap}.abrir-dpi{display:block;width:min(100%,420px);padding:0;border:0;background:transparent;border-radius:10px;cursor:zoom-in}.foto-dpi{width:100%;height:250px;object-fit:contain;background:#f4f4f4;border:1px solid #ddd;border-radius:10px;padding:5px}.abrir-dpi:hover .foto-dpi{border-color:#464482;box-shadow:0 0 0 2px rgba(70,68,130,.15)}.dpi-ampliado{display:block;max-width:100%;max-height:78vh;object-fit:contain;margin:auto}.acciones{display:flex;gap:10px;margin-top:22px}.btn-accion{color:#fff;text-decoration:none;border-radius:8px;padding:10px 17px}.editar{background:#824B44}.volver{background:#6c757d}
</style>
<div class="container-fluid px-3 px-md-4 py-4"><div class="tarjeta"><h3 class="mb-4">Detalle del Cliente</h3>
 <div class="row">
  <div class="col-md-6 mb-3"><div class="detalle-label">Nombre</div><div class="detalle-valor">@Mostrar(Model.Nombre)</div></div>
  <div class="col-md-6 mb-3"><div class="detalle-label">Tipo de cliente</div><div class="detalle-valor"><span class="tipo @clase">@Model.CodigoClasificacion - @Model.NombreClasificacion</span></div></div>
  <div class="col-md-6 mb-3"><div class="detalle-label">Teléfono</div><div class="detalle-valor">@Mostrar(Model.Telefono)</div></div>
  <div class="col-md-6 mb-3"><div class="detalle-label">Empresa de procedencia</div><div class="detalle-valor">@Mostrar(Model.EmpresaProcedencia)</div></div>
  <div class="col-md-6 mb-3"><div class="detalle-label">NIT</div><div class="detalle-valor">@Mostrar(Model.Nit)</div></div>
  <div class="col-md-6 mb-3"><div class="detalle-label">Número de DPI</div><div class="detalle-valor">@Mostrar(Model.NumeroDpi)</div></div>
  <div class="col-md-6 mb-3"><div class="detalle-label">Correo</div><div class="detalle-valor">@Mostrar(Model.Correo)</div></div>
  <div class="col-md-6 mb-3"><div class="detalle-label">Última placa registrada</div><div class="detalle-valor">@Mostrar(Model.PlacaReciente)</div></div>
  <div class="col-md-6 mb-3"><div class="detalle-label">Limpieza habitual</div><div class="detalle-valor">@(Model.SolicitaLimpieza ? "Sí, solicita limpieza" : "No solicita limpieza")</div></div>
  <div class="col-12 mb-3"><div class="detalle-label">Dirección</div><div class="detalle-valor">@Mostrar(Model.Direccion)</div></div>
  <div class="col-md-6 mb-3"><div class="detalle-label">Estado</div><div class="detalle-valor">@Model.Estado</div></div>
 </div>
 @if(Model.TieneDpiFrente){<hr/><h5 class="mb-3">Fotografía del DPI</h5><div class="fotos">
  @if(Model.TieneDpiFrente){<div><div class="detalle-label">Parte frontal</div><button type="button" class="abrir-dpi" data-bs-toggle="modal" data-bs-target="#modalDpi" aria-label="Ampliar fotografía del DPI"><img class="foto-dpi" src="@Url.Action("DocumentoDpi",new{id=Model.IdClipro,tipo="dpi_frente"})" alt="Parte frontal del DPI"/></button></div>}
 </div>}
 @if(Model.TieneDpiFrente){<div class="modal fade" id="modalDpi" tabindex="-1" aria-labelledby="tituloModalDpi" aria-hidden="true"><div class="modal-dialog modal-xl modal-dialog-centered"><div class="modal-content"><div class="modal-header"><h5 class="modal-title" id="tituloModalDpi">Fotografía del DPI</h5><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button></div><div class="modal-body bg-light"><img class="dpi-ampliado" src="@Url.Action("DocumentoDpi",new{id=Model.IdClipro,tipo="dpi_frente"})" alt="Parte frontal ampliada del DPI"/></div></div></div></div>}
 <hr/><h5 class="mb-3">Historial de reservaciones y facturas</h5>
 @if(Model.Reservas.Count == 0){<div class="alert alert-light border">Este cliente todavía no tiene reservaciones registradas.</div>}
 else{<div class="table-responsive"><table class="table table-sm table-hover align-middle"><thead><tr><th>Reserva</th><th>Fechas</th><th>Habitación</th><th>Estadía</th><th>Facturación</th><th></th></tr></thead><tbody>
 @foreach(var reserva in Model.Reservas){<tr><td>#@reserva.IdReserva@if(reserva.IdReservaGrupo.HasValue){<small class="d-block text-muted">Grupo #@reserva.IdReservaGrupo</small>}</td><td>@reserva.FechaEntrada.ToString("dd/MM/yyyy") - @reserva.FechaSalida.ToString("dd/MM/yyyy")</td><td>@reserva.Habitacion</td><td>@reserva.Estado.Replace("_"," ")</td><td>@reserva.EstadoFacturacion.Replace("_"," ")</td><td><a asp-controller="Reservas" asp-action="Detalle" asp-route-id="@reserva.IdReserva" class="btn btn-sm btn-outline-primary">Abrir expediente</a></td></tr>}
 </tbody></table></div>}
 <div class="acciones"><a asp-action="Editar" asp-route-id="@Model.IdClipro" class="btn-accion editar">Editar cliente</a><a asp-action="Index" class="btn-accion volver">Volver al listado</a></div>
</div></div>
