@model System.Data.DataTable
@{ ViewData["Title"]="Clientes"; string busqueda=ViewBag.Busqueda??""; string ordenar=ViewBag.OrdenarPor??"nombre"; string direccion=ViewBag.Direccion??"asc"; string vista=ViewBag.Vista??"activos"; int pagina=ViewBag.PaginaActual??1; int paginas=ViewBag.TotalPaginas??1; int total=ViewBag.TotalRegistros??0; string Dir(string c)=>ordenar==c&&direccion=="asc"?"desc":"asc"; string Icono(string c)=>ordenar!=c?"bi-arrow-down-up":direccion=="asc"?"bi-sort-alpha-down":"bi-sort-alpha-up"; string Tel(object v){var s=v?.ToString()??"";return s.Length==8?s[..4]+" "+s[4..]:s;} }
<style>
 .tarjeta{background:#fff;border-radius:15px;padding:25px;box-shadow:0 4px 10px rgba(0,0,0,.1)}.encabezado{display:flex;justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap}.btn-crear{background:#464482;color:#fff;padding:10px 16px;border-radius:8px;text-decoration:none}.btn-empresa{background:#824B44;color:#fff;padding:10px 16px;border-radius:8px;text-decoration:none}.tabs{display:flex;gap:10px;margin:20px 0}.tab{background:#e6d3d0;color:#363636;padding:9px 14px;border-radius:8px;text-decoration:none}.tab.activa{background:#824B44;color:#fff}.tipo{display:inline-flex;width:32px;height:32px;align-items:center;justify-content:center;border-radius:50%;font-weight:700}.tipo-a{background:#d9f2df;color:#17652b}.tipo-b{background:#fff0c9;color:#885b00}.tipo-c{background:#f7d7d9;color:#8f1d26}.acciones{display:flex;gap:7px}.btn-icono{width:38px;height:38px;border:0;border-radius:8px;color:#fff;display:inline-flex;align-items:center;justify-content:center;text-decoration:none}.detalle{background:#464482}.editar{background:#824B44}.estado{background:#363636}.paginas{display:flex;gap:7px;flex-wrap:wrap;margin-top:18px}.pagina{background:#e6d3d0;color:#363636;padding:7px 11px;border-radius:7px;text-decoration:none}.pagina.activa{background:#464482;color:#fff}.tabla-scroll{overflow-x:auto}.encabezado-orden{color:inherit;text-decoration:none;white-space:nowrap;display:inline-flex;align-items:center;gap:7px}.encabezado-orden:hover{color:inherit}
</style>
<div class="tarjeta"><div class="encabezado"><h3 class="m-0">Gestión de Clientes</h3><div class="d-flex gap-2 flex-wrap"><a asp-controller="EmpresasClientes" asp-action="Index" class="btn-empresa"><i class="bi bi-buildings"></i> Empresas de procedencia</a><a asp-action="Crear" class="btn-crear"><i class="bi bi-person-plus-fill"></i> Nuevo Cliente</a></div></div>
 @if(ViewBag.Mensaje!=null){<div class="alert alert-danger mt-3">@ViewBag.Mensaje</div>} @if(TempData["Exito"]!=null){<div class="alert alert-success mt-3">@TempData["Exito"]</div>} @if(TempData["Mensaje"]!=null){<div class="alert alert-danger mt-3">@TempData["Mensaje"]</div>}
 <div class="tabs"><a asp-action="Index" asp-route-vista="activos" class="tab @(vista=="activos"?"activa":"")">Activos</a><a asp-action="Index" asp-route-vista="inactivos" class="tab @(vista=="inactivos"?"activa":"")">Inactivos</a></div>
 <form method="get" class="mb-3"><input type="hidden" name="vista" value="@vista"/><div class="input-group"><input name="busqueda" value="@busqueda" class="form-control" placeholder="Buscar por nombre, DPI, placa, empresa, teléfono o correo"/><button class="btn btn-dark"><i class="bi bi-search"></i> Buscar</button></div></form>
 <div class="mb-2"><strong>Total de registros:</strong> @total</div><div class="tabla-scroll"><table class="table table-striped table-bordered align-middle"><thead class="table-dark"><tr>
  <th><a class="encabezado-orden" asp-route-ordenarPor="nombre" asp-route-direccion="@Dir("nombre")" asp-route-vista="@vista" asp-route-busqueda="@busqueda">Cliente <i class="bi @Icono("nombre")"></i></a></th>
  <th><a class="encabezado-orden" asp-route-ordenarPor="empresa" asp-route-direccion="@Dir("empresa")" asp-route-vista="@vista" asp-route-busqueda="@busqueda">Empresa de procedencia <i class="bi @Icono("empresa")"></i></a></th>
  <th><a class="encabezado-orden" asp-route-ordenarPor="tipo" asp-route-direccion="@Dir("tipo")" asp-route-vista="@vista" asp-route-busqueda="@busqueda">Tipo <i class="bi @Icono("tipo")"></i></a></th>
  <th><a class="encabezado-orden" asp-route-ordenarPor="telefono" asp-route-direccion="@Dir("telefono")" asp-route-vista="@vista" asp-route-busqueda="@busqueda">Teléfono <i class="bi @Icono("telefono")"></i></a></th>
  <th><a class="encabezado-orden" asp-route-ordenarPor="placa" asp-route-direccion="@Dir("placa")" asp-route-vista="@vista" asp-route-busqueda="@busqueda">Última placa <i class="bi @Icono("placa")"></i></a></th><th>Acciones</th></tr></thead><tbody>
 @foreach(System.Data.DataRow fila in Model.Rows){string codigo=fila["codigo_clasificacion"]?.ToString()??"B";string clase=codigo=="A"?"tipo-a":codigo=="C"?"tipo-c":"tipo-b";<tr><td>@fila["nombre"]</td><td>@(fila["empresa_procedencia"]==DBNull.Value?"-":fila["empresa_procedencia"])</td><td><span class="tipo @clase" title="@fila["nombre_clasificacion"]">@codigo</span></td><td>@Tel(fila["telefono"])</td><td>@(fila["placa_reciente"]==DBNull.Value?"-":fila["placa_reciente"])</td><td><div class="acciones"><a asp-action="Detalle" asp-route-id="@fila["id_clipro"]" class="btn-icono detalle" title="Ver"><i class="bi bi-eye-fill"></i></a><a asp-action="Editar" asp-route-id="@fila["id_clipro"]" class="btn-icono editar" title="Editar"><i class="bi bi-pencil-fill"></i></a><form asp-action="CambiarEstado" method="post">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@fila["id_clipro"]"/><input type="hidden" name="vista" value="@vista"/><button class="btn-icono estado" title="Cambiar estado"><i class="bi bi-arrow-repeat"></i></button></form></div></td></tr>}
 </tbody></table></div>
 @if(paginas>1){<div class="paginas">@for(int i=1;i<=paginas;i++){<a asp-route-pagina="@i" asp-route-vista="@vista" asp-route-busqueda="@busqueda" asp-route-ordenarPor="@ordenar" asp-route-direccion="@direccion" class="pagina @(i==pagina?"activa":"")">@i</a>}</div>}
</div>
