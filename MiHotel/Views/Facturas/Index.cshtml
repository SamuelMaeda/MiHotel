@model MiHotel.Models.FacturasIndexViewModel
@{
    ViewData["Title"] = "Facturas pendientes";
    string EtiquetaEstado(string estado) => estado switch
    {
        "pendiente" => "Pendiente",
        "registrada" => "Registrada",
        "no_solicitada" => "No solicitada",
        "anulada" => "Anulada — requiere revisión",
        _ => estado.Replace("_", " ")
    };
}

<style>
    .contenedor-facturas { background:#fff; border-radius:15px; padding:25px; box-shadow:0 4px 10px rgba(0,0,0,.10); }
    .filtros-facturas { display:flex; flex-wrap:wrap; gap:10px; margin:20px 0; }
    .filtro-factura { padding:9px 14px; border-radius:8px; background:#eee6e4; color:#6e3f39; text-decoration:none; font-weight:600; }
    .filtro-factura.activo { background:#824B44; color:#fff; }
    .estado-fiscal { display:inline-block; border-radius:999px; padding:5px 10px; font-size:13px; font-weight:700; background:#fff0c9; color:#885b00; }
    .estado-registrada { background:#d9f2df; color:#17652b; }
    .estado-no_solicitada { background:#e8e8e8; color:#555; }
    .estado-anulada { background:#f7d7d9; color:#8f1d26; }
    .btn-ver { background:#464482; color:#fff; border-radius:7px; padding:7px 11px; text-decoration:none; white-space:nowrap; }
    .btn-ver:hover { color:#fff; background:#36366b; }
    .acciones-factura { display:flex; flex-wrap:wrap; gap:7px; align-items:center; }
    .btn-cancelar-solicitud { border:0; background:#842029; color:#fff; border-radius:7px; padding:7px 11px; white-space:nowrap; }
</style>

<div class="contenedor-facturas">
    <div class="d-flex justify-content-between align-items-start flex-wrap gap-3">
        <div>
            <h2 class="mb-1">Control de facturación</h2>
            <p class="text-muted mb-0">La habitación y la cuenta funcionan de forma independiente a esta bandeja administrativa.</p>
        </div>
        <a asp-controller="Panel" asp-action="Index" class="btn btn-secondary">Volver al panel</a>
    </div>

    @if (TempData["Exito"] != null) { <div class="alert alert-success mt-3">@TempData["Exito"]</div> }
    @if (TempData["Mensaje"] != null) { <div class="alert alert-danger mt-3">@TempData["Mensaje"]</div> }

    <div class="filtros-facturas">
        <a asp-action="Index" asp-route-vista="pendientes" class="filtro-factura @(Model.Vista == "pendientes" ? "activo" : "")">Pendientes</a>
        <a asp-action="Index" asp-route-vista="registradas" class="filtro-factura @(Model.Vista == "registradas" ? "activo" : "")">Registradas</a>
        <a asp-action="Index" asp-route-vista="no_solicitadas" class="filtro-factura @(Model.Vista == "no_solicitadas" ? "activo" : "")">No solicitadas</a>
        <a asp-action="Index" asp-route-vista="todas" class="filtro-factura @(Model.Vista == "todas" ? "activo" : "")">Todas</a>
    </div>

    <form method="get" class="row g-2 mb-3">
        <input type="hidden" name="vista" value="@Model.Vista" />
        <div class="col-md-9"><input name="busqueda" value="@Model.Busqueda" class="form-control" placeholder="Buscar por huésped, NIT, reserva o grupo" /></div>
        <div class="col-md-3 d-grid"><button class="btn btn-dark" type="submit"><i class="bi bi-search"></i> Buscar</button></div>
    </form>

    <div class="table-responsive">
        <table class="table table-bordered table-striped align-middle">
            <thead class="table-dark">
                <tr><th>Reserva</th><th>Huésped</th><th>Estadía</th><th>Total</th><th>Decisión</th><th>Estado fiscal</th><th>Documentos</th><th></th></tr>
            </thead>
            <tbody>
            @if (Model.Registros.Count == 0)
            {
                <tr><td colspan="8" class="text-center py-4">No hay registros para esta vista.</td></tr>
            }
            else
            {
                @foreach (var fila in Model.Registros)
                {
                    <tr>
                        <td>
                            <strong>#@fila.IdReserva</strong>
                            @if (fila.IdReservaGrupo.HasValue) { <small class="d-block text-muted">Grupo #@fila.IdReservaGrupo</small> }
                        </td>
                        <td>@fila.Cliente<small class="d-block text-muted">NIT: @(string.IsNullOrWhiteSpace(fila.NitCliente) ? "-" : fila.NitCliente)</small></td>
                        <td>@fila.FechaEntrada.ToString("dd/MM/yyyy") – @fila.FechaSalida.ToString("dd/MM/yyyy")<small class="d-block text-muted">@fila.Habitacion</small></td>
                        <td>Q @fila.TotalReserva.ToString("N2")</td>
                        <td>@(fila.FechaDecision?.ToString("dd/MM/yyyy HH:mm") ?? "-")<small class="d-block text-muted">@fila.UsuarioDecision</small></td>
                        <td><span class="estado-fiscal estado-@fila.EstadoFacturacion">@EtiquetaEstado(fila.EstadoFacturacion)</span></td>
                        <td>@fila.CantidadDocumentos</td>
                        <td>
                            <div class="acciones-factura">
                                <a asp-controller="Reservas" asp-action="Detalle" asp-route-id="@fila.IdReserva" class="btn-ver">Abrir expediente</a>
                                @if (fila.EstadoFacturacion is "pendiente" or "anulada")
                                {
                                    <form asp-controller="Facturas" asp-action="CancelarSolicitud" method="post"
                                          onsubmit="return confirm('¿Confirma que el huésped ya no necesita factura? La reservación saldrá de Facturas pendientes.');">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="idReserva" value="@fila.IdReserva" />
                                        <input type="hidden" name="retorno" value="facturas" />
                                        <input type="hidden" name="busqueda" value="@Model.Busqueda" />
                                        <button type="submit" class="btn-cancelar-solicitud">Cancelar solicitud</button>
                                    </form>
                                }
                            </div>
                        </td>
                    </tr>
                }
            }
            </tbody>
        </table>
    </div>
</div>
