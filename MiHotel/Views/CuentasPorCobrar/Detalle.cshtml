@model MiHotel.Models.CuentaPorCobrarDetalleViewModel
@using System.Data

@{
    ViewData["Title"] = "Detalle de cuenta por cobrar";
    bool puedeCobrar = ViewBag.PuedeCobrar is bool valor && valor;
    bool volverCheckout = Model.EsCuentaAgrupada
        ? Model.IdReservaRetorno.HasValue
        : Model.EstadoReserva.Trim().ToLower() == "en_checkout";
    string accionRegistrar = Model.EsCuentaAgrupada ? "RegistrarAbonoGrupo" : "RegistrarAbono";
    DataTable formasPago = ViewBag.FormasPago as DataTable ?? new DataTable();
    decimal recargoTarjetaUnitario = ViewBag.RecargoTarjeta is decimal recargo ? recargo : 25m;
    int unidadesRecargo = Model.EsCuentaAgrupada
        ? Model.EstadiasAgrupadas
            .Where(estadia => estadia.Estado.Trim().ToLower() != "cancelada"
                && estadia.SaldoPendiente > 0
                && !estadia.RecargoTarjetaAplicado)
            .Sum(estadia => estadia.CantidadPersonas * Math.Max(1, (estadia.FechaSalida.Date - estadia.FechaEntrada.Date).Days))
        : Model.RecargoTarjetaAplicado
            ? 0
            : Model.CantidadPersonas * Math.Max(1, (Model.FechaSalida.Date - Model.FechaEntrada.Date).Days);
    decimal recargoTarjeta = recargoTarjetaUnitario * unidadesRecargo;
}

<style>
    .tarjeta-contenido {
        background-color: white;
        border-radius: 15px;
        padding: 25px;
        box-shadow: 0 4px 10px rgba(0,0,0,0.10);
    }

    .resumen-cuenta {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(190px, 1fr));
        gap: 14px;
        margin-bottom: 22px;
    }

    .dato-cuenta {
        background-color: #f5efee;
        border: 1px solid #e6d3d0;
        border-radius: 10px;
        padding: 14px;
    }

    .dato-cuenta span {
        color: #6c757d;
        display: block;
        font-size: 13px;
        margin-bottom: 4px;
    }

    .saldo-cuenta { color: #842029; font-size: 1.35rem; font-weight: 700; }

    .formulario-abono {
        background-color: #f8f9fa;
        border: 1px solid #dee2e6;
        border-radius: 10px;
        padding: 18px;
        margin-bottom: 24px;
    }

    .btn-accion {
        border: none;
        border-radius: 8px;
        color: white;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 9px 14px;
        text-decoration: none;
        font-weight: 500;
    }

    .btn-accion:hover { color: white; }
    .btn-guardar { background-color: #464482; }
    .btn-volver { background-color: #824B44; }
    .resumen-recargo { background:#fff4d6;border:1px solid #f0d58c;border-radius:10px;padding:14px 16px; }
</style>

<div class="tarjeta-contenido mh-page-shell">
    <div class="mh-page-header">
        <div>
            @if (Model.EsCuentaAgrupada)
            {
                <h3 class="mb-1">Cuenta de la reserva agrupada #@Model.IdReservaGrupo</h3>
                <p class="text-muted mb-0">Una sola cuenta para todas las fechas seleccionadas.</p>
            }
            else
            {
                <h3 class="mb-1">Cuenta de la reservación #@Model.IdReserva</h3>
                <p class="text-muted mb-0">Registro y corrección de abonos de la estadía.</p>
            }
        </div>
    </div>

    @if (TempData["Exito"] != null)
    {
        <div class="alert alert-success">@TempData["Exito"]</div>
    }

    @if (TempData["Mensaje"] != null)
    {
        <div class="alert alert-danger">@TempData["Mensaje"]</div>
    }

    <div class="resumen-cuenta">
        <div class="dato-cuenta"><span>Cliente</span><strong>@Model.Cliente</strong></div>
        <div class="dato-cuenta"><span>Habitación</span><strong>@Model.Habitacion</strong></div>
        <div class="dato-cuenta"><span>Primera entrada</span><strong>@Model.FechaEntrada.ToString("dd/MM/yyyy")</strong></div>
        <div class="dato-cuenta"><span>Última salida</span><strong>@Model.FechaSalida.ToString("dd/MM/yyyy")</strong></div>
        <div class="dato-cuenta"><span>Estado</span><strong>@(Model.EsCuentaAgrupada ? "Varias estadías" : Model.EstadoReserva.Replace("_", " "))</strong></div>
        <div class="dato-cuenta">
            <span>@(Model.EsCuentaAgrupada ? "Saldo total de la reserva agrupada" : "Saldo pendiente")</span>
            <strong id="saldoPendienteCuenta"
                    class="saldo-cuenta"
                    data-saldo-base="@Model.SaldoPendiente.ToString(System.Globalization.CultureInfo.InvariantCulture)">
                Q @Model.SaldoPendiente.ToString("N2")
            </strong>
        </div>
    </div>

    @if (Model.EsCuentaAgrupada)
    {
        <h5>Fechas incluidas en la cuenta</h5>
        <div class="table-responsive mb-4">
            <table class="table table-bordered table-striped align-middle mh-table" data-mh-sortable>
                <thead class="table-dark">
                    <tr>
                        <th>Reservación</th>
                        <th>Habitación</th>
                        <th>Entrada</th>
                        <th>Salida</th>
                        <th>Total</th>
                        <th>Saldo</th>
                        <th>Estado</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var estadia in Model.EstadiasAgrupadas)
                    {
                        <tr>
                            <td>#@estadia.IdReserva</td>
                            <td>@estadia.Habitacion</td>
                            <td>@estadia.FechaEntrada.ToString("dd/MM/yyyy")</td>
                            <td>@estadia.FechaSalida.ToString("dd/MM/yyyy")</td>
                            <td>Q @estadia.TotalReserva.ToString("N2")</td>
                            <td>Q @estadia.SaldoPendiente.ToString("N2")</td>
                            <td>@estadia.Estado.Replace("_", " ")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    @if (puedeCobrar && Model.SaldoPendiente > 0)
    {
        <div class="formulario-abono">
            <h5>Registrar abono</h5>
            <form asp-controller="CuentasPorCobrar" asp-action="@accionRegistrar" method="post" class="row g-3">
                @Html.AntiForgeryToken()
                @if (Model.EsCuentaAgrupada)
                {
                    <input type="hidden" name="idReservaGrupo" value="@Model.IdReservaGrupo" />
                    <input type="hidden" name="idReservaRetorno" value="@Model.IdReservaRetorno" />
                }
                else
                {
                    <input type="hidden" name="idReserva" value="@Model.IdReserva" />
                }
                <input type="hidden" name="volverCheckout" value="@volverCheckout.ToString().ToLower()" />

                @if (Model.EsCuentaAgrupada)
                {
                    <div class="col-12">
                        <label for="idReservaObjetivo" class="form-label">Aplicar el pago a</label>
                        <select id="idReservaObjetivo" name="idReservaObjetivo" class="form-select">
                            <option value=""
                                    data-saldo="@Model.SaldoPendiente.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                    data-recargo="@recargoTarjeta.ToString(System.Globalization.CultureInfo.InvariantCulture)">
                                Todas las estadías del grupo — saldo total Q @Model.SaldoPendiente.ToString("N2")
                            </option>
                            @foreach (var estadia in Model.EstadiasAgrupadas.Where(estadia =>
                                estadia.Estado.Trim().ToLower() != "cancelada" && estadia.SaldoPendiente > 0))
                            {
                                <option value="@estadia.IdReserva"
                                        data-saldo="@estadia.SaldoPendiente.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                        data-recargo="@((estadia.RecargoTarjetaAplicado
                                            ? 0
                                            : recargoTarjetaUnitario * estadia.CantidadPersonas * Math.Max(1, (estadia.FechaSalida.Date - estadia.FechaEntrada.Date).Days)).ToString(System.Globalization.CultureInfo.InvariantCulture))">
                                    Solo estadía #@estadia.IdReserva del @estadia.FechaEntrada.ToString("dd/MM/yyyy") — saldo Q @estadia.SaldoPendiente.ToString("N2")
                                </option>
                            }
                        </select>
                        <small class="text-muted">
                            Puede pagar una fecha específica o reducir conjuntamente el saldo de todas las estadías.
                        </small>
                    </div>
                }

                <div class="col-md-4">
                    <label for="monto" class="form-label">Monto</label>
                    <input id="monto" name="monto" type="number" min="0.01" max="@Model.SaldoPendiente.ToString(System.Globalization.CultureInfo.InvariantCulture)" step="0.01" class="form-control" required />
                    @if (Model.EsCuentaAgrupada)
                    {
                        <button id="usarSaldoCompleto" type="button" class="btn btn-sm btn-outline-secondary mt-2">
                            <i class="bi bi-check2-square me-1"></i> Usar el saldo completo seleccionado
                        </button>
                    }
                </div>
                <div class="col-md-4">
                    <label for="idFormaPago" class="form-label">Forma de pago</label>
                    <select id="idFormaPago" name="idFormaPago" class="form-select" required>
                        <option value="">Seleccione</option>
                        @foreach (DataRow forma in formasPago.Rows)
                        {
                            <option value="@forma["id_formapago"]" data-es-tarjeta="@(Convert.ToInt32(forma["es_tarjeta"]) == 1 ? "true" : "false")">@forma["nombre_forma"]</option>
                        }
                    </select>
                </div>
                <div id="resumenRecargoTarjeta" class="col-12 d-none">
                    <div class="resumen-recargo">
                        <strong>Pago con tarjeta</strong>
                        <div>Monto que reduce la deuda: Q <span id="montoAbonoResumen">0.00</span></div>
                        <div>Recargo por personas y noches: Q <span id="recargoResumen">@recargoTarjeta.ToString("N2")</span></div>
                        <div class="fw-bold mt-1">Total a cobrar en la terminal: Q <span id="totalCobroResumen">@recargoTarjeta.ToString("N2")</span></div>
                    </div>
                </div>
                <div class="col-md-4">
                    <label for="referencia" class="form-label">Referencia opcional</label>
                    <input id="referencia" name="referencia" class="form-control" maxlength="100" placeholder="Transferencia o depósito" />
                </div>
                <div class="col-12">
                    <label for="observaciones" class="form-label">Observaciones opcionales</label>
                    <textarea id="observaciones" name="observaciones" class="form-control" rows="2" maxlength="140"></textarea>
                </div>
                <div class="col-12">
                    <button type="submit" class="btn-accion btn-guardar mh-btn mh-btn-primary"><i class="bi bi-cash-coin"></i> Registrar abono</button>
                </div>
            </form>
        </div>
    }
    else if (!puedeCobrar && Model.SaldoPendiente > 0)
    {
        <div class="alert alert-warning">Puede consultar la cuenta, pero su rol no tiene permiso para registrar o corregir abonos.</div>
    }

    <h5>Historial de movimientos</h5>
    <div class="table-responsive">
        <table class="table table-bordered table-striped align-middle mh-table" data-mh-sortable>
            <thead class="table-dark">
                <tr>
                    <th>Fecha</th>
                    <th>Movimiento</th>
                    <th>Forma de pago</th>
                    <th>Abono</th>
                    <th>Recargo</th>
                    <th>Total cobrado</th>
                    <th>Estado</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Movimientos.Count == 0)
                {
                    <tr><td colspan="7" class="text-center py-3">No hay movimientos registrados.</td></tr>
                }
                else
                {
                    foreach (var movimiento in Model.Movimientos)
                    {
                        <tr>
                            <td>@movimiento.FechaHora.ToString("dd/MM/yyyy HH:mm")</td>
                            <td>@movimiento.MovimientoLegible</td>
                            <td>@movimiento.FormaPagoLegible</td>
                            <td>Q @movimiento.Monto.ToString("N2")</td>
                            <td>@(movimiento.RecargoTarjeta > 0 ? $"Q {movimiento.RecargoTarjeta:N2}" : "—")</td>
                            <td>Q @movimiento.TotalCobrado.ToString("N2")</td>
                            <td>@(movimiento.Estado.Trim().ToLower() == "activo" ? "Activo" : "Anulado")</td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    <div class="mh-bottom-actions">
        @if (volverCheckout)
        {
            <a asp-controller="Reservas" asp-action="Checkout" asp-route-id="@(Model.IdReservaRetorno ?? Model.IdReserva)" class="btn-accion btn-volver mh-btn mh-btn-back">
                <i class="bi bi-arrow-left-circle-fill"></i> Volver al check-out
            </a>
        }
        else
        {
            <a asp-controller="CuentasPorCobrar" asp-action="Index" class="btn-accion btn-volver mh-btn mh-btn-back">
                <i class="bi bi-arrow-left-circle-fill"></i> Volver al listado
            </a>
        }
    </div>

</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        const monto = document.getElementById("monto");
        const formaPago = document.getElementById("idFormaPago");
        const resumen = document.getElementById("resumenRecargoTarjeta");
        const montoResumen = document.getElementById("montoAbonoResumen");
        const recargoResumen = document.getElementById("recargoResumen");
        const totalResumen = document.getElementById("totalCobroResumen");
        const recargoPredeterminado = @recargoTarjeta.ToString(System.Globalization.CultureInfo.InvariantCulture);

        window.actualizarResumenRecargo = function () {
            if (!formaPago || !resumen || !monto || !montoResumen || !recargoResumen || !totalResumen) return;
            const opcion = formaPago.options[formaPago.selectedIndex];
            const esTarjeta = opcion?.dataset.esTarjeta === "true";
            const valorMonto = Number.parseFloat(monto.value) || 0;
            const destino = document.getElementById("idReservaObjetivo");
            const opcionDestino = destino?.options[destino.selectedIndex];
            const recargoConfigurado = Number.parseFloat(opcionDestino?.dataset.recargo);
            const recargo = Number.isFinite(recargoConfigurado)
                ? recargoConfigurado
                : recargoPredeterminado;

            resumen.classList.toggle("d-none", !esTarjeta);
            montoResumen.textContent = valorMonto.toLocaleString("es-GT", { minimumFractionDigits: 2, maximumFractionDigits: 2 });
            recargoResumen.textContent = recargo.toLocaleString("es-GT", { minimumFractionDigits: 2, maximumFractionDigits: 2 });
            totalResumen.textContent = (valorMonto + recargo).toLocaleString("es-GT", { minimumFractionDigits: 2, maximumFractionDigits: 2 });
        };

        formaPago?.addEventListener("change", window.actualizarResumenRecargo);
        monto?.addEventListener("input", window.actualizarResumenRecargo);
        window.actualizarResumenRecargo();
    });
</script>

@if (Model.EsCuentaAgrupada)
{
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const destino = document.getElementById("idReservaObjetivo");
            const monto = document.getElementById("monto");
            const usarSaldoCompleto = document.getElementById("usarSaldoCompleto");

            if (!destino || !monto) {
                return;
            }

            function actualizarMontoMaximo() {
                const opcion = destino.options[destino.selectedIndex];
                const saldo = opcion ? opcion.dataset.saldo : null;

                if (saldo) {
                    monto.max = saldo;
                }
            }

            destino.addEventListener("change", actualizarMontoMaximo);
            destino.addEventListener("change", function () {
                window.actualizarResumenRecargo?.();
            });
            usarSaldoCompleto?.addEventListener("click", function () {
                const opcion = destino.options[destino.selectedIndex];
                const saldo = opcion ? opcion.dataset.saldo : null;

                if (saldo) {
                    monto.value = saldo;
                    monto.focus();
                    window.actualizarResumenRecargo?.();
                }
            });
            actualizarMontoMaximo();
        });
    </script>
}
