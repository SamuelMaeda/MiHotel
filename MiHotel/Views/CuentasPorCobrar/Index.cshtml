@model System.Data.DataTable

@{
    ViewData["Title"] = "Cuentas por Cobrar";

    string busqueda = ViewBag.Busqueda ?? "";
    string ordenarPor = ViewBag.OrdenarPor ?? "fecha_entrada";
    string direccion = ViewBag.Direccion ?? "desc";
    string vista = ViewBag.Vista ?? "estadias";

    int paginaActual = ViewBag.PaginaActual ?? 1;
    int totalPaginas = ViewBag.TotalPaginas ?? 1;
    int totalRegistros = ViewBag.TotalRegistros ?? 0;

    string SiguienteDireccion(string columna)
    {
        if (ordenarPor == columna && direccion == "asc")
        {
            return "desc";
        }

        return "asc";
    }

    string IconoOrden(string columna)
    {
        if (ordenarPor != columna)
        {
            return "bi-arrow-down-up";
        }

        return direccion == "asc"
            ? "bi-sort-alpha-down"
            : "bi-sort-alpha-up";
    }
}
<style>

    .tarjeta-contenido {
        background: white;
        border-radius: 15px;
        padding: 25px;
        box-shadow: 0 4px 10px rgba(0,0,0,.10);
    }

    .btn-crear {
        background: #464482;
        color: white;
        padding: 10px 16px;
        border-radius: 8px;
        text-decoration: none;
        font-weight: 500;
    }

    .tabs-vista {
        display: flex;
        gap: 10px;
        margin-bottom: 20px;
        flex-wrap: wrap;
    }

    .tab-vista {
        text-decoration: none;
        padding: 10px 14px;
        border-radius: 8px;
        background: #E6D3D0;
        color: #363636;
        font-weight: 500;
    }

        .tab-vista.activa {
            background: #824B44;
            color: white;
        }

    .paginacion {
        display: flex;
        gap: 8px;
        flex-wrap: wrap;
        margin-top: 20px;
    }

    .pagina-link {
        padding: 8px 12px;
        border-radius: 8px;
        background: #E6D3D0;
        color: #363636;
        text-decoration: none;
    }

        .pagina-link.activa {
            background: #464482;
            color: white;
            font-weight: bold;
        }

    .encabezado-orden {
        color: inherit;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        font-weight: 600;
    }

    .btn-icono {
        width: 38px;
        height: 38px;
        border: none;
        border-radius: 8px;
        display: inline-flex;
        justify-content: center;
        align-items: center;
        color: white;
        text-decoration: none;
        background: #5a58a6;
    }

        .btn-icono:hover {
            color: white;
        }

    .estado-pendiente {
        color: #842029;
        font-weight: bold;
    }

</style>

<div class="tarjeta-contenido">

    <div class="d-flex justify-content-between align-items-center mb-3">

        <h3 class="m-0">
            Cuentas por Cobrar
        </h3>

        <div>

            <a href="#"
               class="btn-crear"
               onclick="return false;">

                Historial

            </a>

        </div>

    </div>


    <div class="tabs-vista">

        <a asp-action="Index"
           asp-route-vista="estadias"
           asp-route-busqueda="@busqueda"
           asp-route-ordenarPor="@ordenarPor"
           asp-route-direccion="@direccion"
           class="tab-vista @(vista == "estadias" ? "activa" : "")">

            Ver por estadías

        </a>

        <a asp-action="Index"
           asp-route-vista="cliente"
           asp-route-busqueda="@busqueda"
           asp-route-ordenarPor="@ordenarPor"
           asp-route-direccion="@direccion"
           class="tab-vista @(vista == "cliente" ? "activa" : "")">

            Ver por cliente

        </a>

    </div>


@if (TempData["Exito"] != null)
{
        <div class="alert alert-success">
            @TempData["Exito"]
        </div>
}

@if (TempData["Mensaje"] != null)
{
        <div class="alert alert-danger">
            @TempData["Mensaje"]
        </div>
}


    <form id="formBusqueda"
          asp-action="Index"
          method="get"
          class="mb-4">

        <input type="hidden"
               name="vista"
               value="@vista" />

        <input type="hidden"
               name="ordenarPor"
               value="@ordenarPor" />

        <input type="hidden"
               name="direccion"
               value="@direccion" />

        <label class="form-label">

            Buscar cuenta

        </label>

        <input type="text"
               id="busqueda"
               name="busqueda"
               value="@busqueda"
               class="form-control"
               placeholder="Buscar por cliente o habitación" />

    </form>


    <div class="mb-3">

        <strong>Total de registros:</strong>

        @totalRegistros

    </div>


    <div class="table-responsive">

        <table class="table table-bordered table-striped">

            <thead class="table-dark">

                <tr>
            <thead class="table-dark">

                <tr>

                    <th>

                        <a asp-action="Index"
                           asp-route-vista="@vista"
                           asp-route-busqueda="@busqueda"
                           asp-route-ordenarPor="cliente"
                           asp-route-direccion="@SiguienteDireccion("cliente")"
                           class="encabezado-orden">

                            Cliente

                            <i class="bi @IconoOrden("cliente")"></i>

                        </a>

                    </th>

                    <th>

                        <a asp-action="Index"
                           asp-route-vista="@vista"
                           asp-route-busqueda="@busqueda"
                           asp-route-ordenarPor="habitacion"
                           asp-route-direccion="@SiguienteDireccion("habitacion")"
                           class="encabezado-orden">

                            Habitación

                            <i class="bi @IconoOrden("habitacion")"></i>

                        </a>

                    </th>

                    <th>

                        <a asp-action="Index"
                           asp-route-vista="@vista"
                           asp-route-busqueda="@busqueda"
                           asp-route-ordenarPor="fecha_entrada"
                           asp-route-direccion="@SiguienteDireccion("fecha_entrada")"
                           class="encabezado-orden">

                            Entrada

                            <i class="bi @IconoOrden("fecha_entrada")"></i>

                        </a>

                    </th>

                    <th>

                        Salida

                    </th>

                    <th class="text-end">

                        <a asp-action="Index"
                           asp-route-vista="@vista"
                           asp-route-busqueda="@busqueda"
                           asp-route-ordenarPor="saldo"
                           asp-route-direccion="@SiguienteDireccion("saldo")"
                           class="encabezado-orden">

                            Saldo Pendiente

                            <i class="bi @IconoOrden("saldo")"></i>

                        </a>

                    </th>

                    <th>

                        Estado

                    </th>

                    <th>

                        Acciones

                    </th>

                </tr>

            </thead>

            <tbody>

                @if (Model.Rows.Count == 0)
                {
                    <tr>

                        <td colspan="7" class="text-center py-4">

                            No existen cuentas por cobrar registradas.

                        </td>

                    </tr>
                }
                else
                {
                    @foreach (System.Data.DataRow fila in Model.Rows)
                    {
                        <tr>

                            <td>

                                @fila["cliente"]

                            </td>

                            <td>

                                @(fila["habitacion"] == DBNull.Value
                                                        ? "-"
                                                        : fila["habitacion"])

                    </td>

                            <td>

                        @if (fila["fecha_entrada"] != DBNull.Value)
                                {
                                    @Convert.ToDateTime(fila["fecha_entrada"]).ToString("dd/MM/yyyy")
                                }
                                else
                                {
                                    @:-
                                }

                            </td>

                            <td>

                                @if (fila["fecha_salida"] != DBNull.Value)
                                {
                                    @Convert.ToDateTime(fila["fecha_salida"]).ToString("dd/MM/yyyy")
                                }
                                else
                                {
                                    @:-
                                }

                            </td>

                            <td class="text-end saldo">

                                Q @Convert.ToDecimal(fila["saldo"]).ToString("N2")

                            </td>

                            <td>

                                <span class="estado-pendiente">
                                    Pendiente
                                </span>

                            </td>

                            <td>

                                <button type="button"
                                        class="btn-icono"
                                        disabled>

                                    <i class="bi bi-folder2-open"></i>

                                </button>

                            </td>

                        </tr>
                    }
                }

            </tbody>

        </table>

    </div>
