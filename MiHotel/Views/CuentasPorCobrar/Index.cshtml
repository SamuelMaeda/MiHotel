@model System.Data.DataTable

@{
    ViewData["Title"] = "Cuentas por Cobrar";
    string busqueda = ViewBag.Busqueda ?? "";
    string ordenarPor = ViewBag.OrdenarPor ?? "fecha_entrada";
    string direccion = ViewBag.Direccion ?? "desc";
    int paginaActual = ViewBag.PaginaActual ?? 1;
    int totalPaginas = ViewBag.TotalPaginas ?? 1;
    int totalRegistros = ViewBag.TotalRegistros ?? 0;

    string SiguienteDireccion(string columna) =>
        ordenarPor == columna && direccion == "asc" ? "desc" : "asc";

    string IconoOrden(string columna)
    {
        if (ordenarPor != columna) return "bi-arrow-down-up";
        return direccion == "asc" ? "bi-sort-alpha-down" : "bi-sort-alpha-up";
    }

    string EtiquetaEstado(string estado) => estado switch
    {
        "pendiente" => "Pendiente de ingreso",
        "en_curso" => "En curso",
        "en_checkout" => "En check-out",
        "finalizada" => "Finalizada",
        _ => estado.Replace("_", " ")
    };
}

<style>
    .tarjeta-contenido {
        background-color: white;
        border-radius: 15px;
        padding: 25px;
        box-shadow: 0 4px 10px rgba(0,0,0,0.10);
    }

    .encabezado-orden {
        color: inherit;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        font-weight: 600;
    }

    .acciones-contenedor { display: flex; gap: 8px; flex-wrap: wrap; }

    .btn-icono {
        width: 38px;
        height: 38px;
        border-radius: 8px;
        border: none;
        display: inline-flex;
        justify-content: center;
        align-items: center;
        color: white;
        text-decoration: none;
        font-size: 16px;
        background-color: #464482;
    }

    .btn-icono:hover { color: white; }
    .estado-pendiente { color: #856404; font-weight: bold; }
    .estado-finalizada { color: #0c5460; font-weight: bold; }
    .estado-en_curso { color: #0c5460; font-weight: bold; }
    .estado-en_checkout { color: #b45309; font-weight: bold; }

    .etiqueta-grupo {
        display: inline-block;
        margin-top: 4px;
        padding: 2px 7px;
        border-radius: 999px;
        background-color: #e6d3d0;
        color: #824b44;
        font-size: 0.78rem;
        font-weight: 600;
    }

    .paginacion { display: flex; gap: 8px; flex-wrap: wrap; margin-top: 20px; }
    .pagina-link {
        padding: 8px 12px;
        border-radius: 8px;
        background-color: #E6D3D0;
        color: #363636;
        text-decoration: none;
        min-width: 40px;
        text-align: center;
    }
    .pagina-link.activa { background-color: #464482; color: white; font-weight: bold; }
</style>

<div class="tarjeta-contenido">
    <h3 class="mb-4">Cuentas por Cobrar</h3>

    @if (TempData["Exito"] != null)
    {
        <div class="alert alert-success">@TempData["Exito"]</div>
    }
    @if (TempData["Mensaje"] != null)
    {
        <div class="alert alert-danger">@TempData["Mensaje"]</div>
    }
    @if (ViewBag.Mensaje != null)
    {
        <div class="alert alert-danger">@ViewBag.Mensaje</div>
    }

    <form id="formBusqueda" asp-controller="CuentasPorCobrar" asp-action="Index" method="get" class="mb-4">
        <input type="hidden" name="ordenarPor" value="@ordenarPor" />
        <input type="hidden" name="direccion" value="@direccion" />
        <label for="busqueda" class="form-label">Buscar cuenta</label>
        <input type="text" id="busqueda" name="busqueda" value="@busqueda" class="form-control"
               placeholder="Buscar por cliente, empresa, habitación, grupo u observaciones" autocomplete="off" />
    </form>

    <div class="mb-3"><strong>Total de registros:</strong> @totalRegistros</div>

    <div class="table-responsive">
        <table class="table table-bordered table-striped align-middle">
            <thead class="table-dark">
                <tr>
                    <th><a asp-action="Index" asp-route-busqueda="@busqueda" asp-route-ordenarPor="cliente" asp-route-direccion="@SiguienteDireccion("cliente")" class="encabezado-orden">Cliente <i class="bi @IconoOrden("cliente")"></i></a></th>
                    <th><a asp-action="Index" asp-route-busqueda="@busqueda" asp-route-ordenarPor="empresa" asp-route-direccion="@SiguienteDireccion("empresa")" class="encabezado-orden">Empresa <i class="bi @IconoOrden("empresa")"></i></a></th>
                    <th><a asp-action="Index" asp-route-busqueda="@busqueda" asp-route-ordenarPor="habitacion" asp-route-direccion="@SiguienteDireccion("habitacion")" class="encabezado-orden">Habitación <i class="bi @IconoOrden("habitacion")"></i></a></th>
                    <th><a asp-action="Index" asp-route-busqueda="@busqueda" asp-route-ordenarPor="fecha_entrada" asp-route-direccion="@SiguienteDireccion("fecha_entrada")" class="encabezado-orden">Entrada <i class="bi @IconoOrden("fecha_entrada")"></i></a></th>
                    <th><a asp-action="Index" asp-route-busqueda="@busqueda" asp-route-ordenarPor="fecha_salida" asp-route-direccion="@SiguienteDireccion("fecha_salida")" class="encabezado-orden">Salida <i class="bi @IconoOrden("fecha_salida")"></i></a></th>
                    <th><a asp-action="Index" asp-route-busqueda="@busqueda" asp-route-ordenarPor="hora_checkin" asp-route-direccion="@SiguienteDireccion("hora_checkin")" class="encabezado-orden">Hora de check-in <i class="bi @IconoOrden("hora_checkin")"></i></a></th>
                    <th><a asp-action="Index" asp-route-busqueda="@busqueda" asp-route-ordenarPor="hora_checkout" asp-route-direccion="@SiguienteDireccion("hora_checkout")" class="encabezado-orden">Hora de check-out <i class="bi @IconoOrden("hora_checkout")"></i></a></th>
                    <th><a asp-action="Index" asp-route-busqueda="@busqueda" asp-route-ordenarPor="total" asp-route-direccion="@SiguienteDireccion("total")" class="encabezado-orden">Total <i class="bi @IconoOrden("total")"></i></a></th>
                    <th><a asp-action="Index" asp-route-busqueda="@busqueda" asp-route-ordenarPor="saldo" asp-route-direccion="@SiguienteDireccion("saldo")" class="encabezado-orden">Pago Pendiente <i class="bi @IconoOrden("saldo")"></i></a></th>
                    <th>Estado</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Rows.Count == 0)
                {
                    <tr><td colspan="11" class="text-center py-4">No existen cuentas por cobrar pendientes.</td></tr>
                }
                else
                {
                    foreach (System.Data.DataRow fila in Model.Rows)
                    {
                        string estado = fila["estado"]?.ToString()?.Trim().ToLower() ?? "";
                        <tr>
                            <td>
                                <div>@fila["cliente"]</div>
                                @if (fila["id_reserva_grupo"] != DBNull.Value)
                                {
                                    <span class="etiqueta-grupo">Grupo #@fila["id_reserva_grupo"]</span>
                                }
                            </td>
                            <td>@(fila["empresa_procedencia"] == DBNull.Value ? "-" : fila["empresa_procedencia"])</td>
                            <td>@fila["habitacion"]</td>
                            <td>@Convert.ToDateTime(fila["fecha_entrada"]).ToString("dd/MM/yyyy")</td>
                            <td>@Convert.ToDateTime(fila["fecha_salida"]).ToString("dd/MM/yyyy")</td>
                            <td>@(fila["fecha_hora_checkin"] == DBNull.Value ? "-" : Convert.ToDateTime(fila["fecha_hora_checkin"]).ToString("HH:mm"))</td>
                            <td>@(fila["fecha_hora_checkout"] == DBNull.Value ? "-" : Convert.ToDateTime(fila["fecha_hora_checkout"]).ToString("HH:mm"))</td>
                            <td>Q @Convert.ToDecimal(fila["total_reserva"]).ToString("N2")</td>
                            <td>Q @Convert.ToDecimal(fila["saldo"]).ToString("N2")</td>
                            <td><span class="estado-@estado">@EtiquetaEstado(estado)</span></td>
                            <td>
                                <div class="acciones-contenedor">
                                    <a asp-controller="CuentasPorCobrar" asp-action="Detalle" asp-route-id="@fila["id_reserva"]" class="btn-icono" title="Gestionar cuenta y pagos">
                                        <i class="bi bi-folder2-open"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    @if (totalPaginas > 1)
    {
        <div class="paginacion">
            @for (int numeroPagina = 1; numeroPagina <= totalPaginas; numeroPagina++)
            {
                <a asp-action="Index" asp-route-busqueda="@busqueda" asp-route-ordenarPor="@ordenarPor"
                   asp-route-direccion="@direccion" asp-route-pagina="@numeroPagina"
                   class="pagina-link @(numeroPagina == paginaActual ? "activa" : "")">@numeroPagina</a>
            }
        </div>
    }
</div>

@section Scripts {
    <script>
        let temporizadorBusqueda;
        const campoBusqueda = document.getElementById("busqueda");
        const formularioBusqueda = document.getElementById("formBusqueda");

        campoBusqueda.addEventListener("input", function () {
            clearTimeout(temporizadorBusqueda);
            temporizadorBusqueda = setTimeout(function () {
                formularioBusqueda.submit();
            }, 350);
        });
    </script>
}
