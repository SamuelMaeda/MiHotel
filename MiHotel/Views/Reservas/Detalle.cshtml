@model MiHotel.Models.ReservaDetalleViewModel

@{
    ViewData["Title"] = "Detalle de Reserva";

    string MostrarTexto(string? valor)
    {
        return string.IsNullOrWhiteSpace(valor) ? "-" : valor;
    }

    string MostrarEstado(string estado)
    {
        return estado.Trim().ToLower() switch
        {
            "pendiente" => "Pendiente de ingreso",
            "en_curso" => "En curso",
            "en_checkout" => "En check-out",
            "cancelada" => "Cancelada",
            "finalizada" => "Finalizada",
            _ => estado
        };
    }
}

<style>
    .tarjeta-contenido {
        background-color: white;
        border-radius: 15px;
        padding: 25px;
        box-shadow: 0 4px 10px rgba(0,0,0,0.10);
        max-width: 900px;
    }

    .detalle-label {
        font-weight: 600;
        color: #363636;
        margin-bottom: 6px;
    }

    .detalle-valor {
        background-color: #f8f9fa;
        border: 1px solid #dee2e6;
        border-radius: 8px;
        padding: 10px 12px;
        min-height: 44px;
        display: flex;
        align-items: center;
        color: #363636;
    }

    .estado-pendiente {
        color: #856404;
        font-weight: bold;
    }

    .estado-en_curso {
        color: #0c5460;
        font-weight: bold;
    }

    .estado-en_checkout {
        color: #b45309;
        font-weight: bold;
    }

    .estado-cancelada {
        color: #842029;
        font-weight: bold;
    }

    .estado-finalizada {
        color: #0c5460;
        font-weight: bold;
    }

    .btn-volver {
        background-color: #824B44;
        color: white;
        text-decoration: none;
        padding: 10px 18px;
        border-radius: 8px;
        font-weight: 500;
        display: inline-block;
    }

    .btn-cuenta {
        background-color: #464482;
        color: white;
        text-decoration: none;
        padding: 10px 18px;
        border-radius: 8px;
        font-weight: 500;
        display: inline-block;
    }

        .btn-cuenta:hover {
            background-color: #36366b;
            color: white;
        }

        .btn-volver:hover {
            background-color: #6e3f39;
            color: white;
        }

    .acciones-formulario {
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
        margin-top: 20px;
    }

    .reserva-grupo-panel {
        border: 1px solid #e6d3d0;
        border-radius: 10px;
        padding: 16px;
        margin-top: 8px;
    }

    .fila-reserva-actual {
        background-color: #f8f1f0 !important;
    }
</style>

<div class="tarjeta-contenido">
    <h3 class="mb-4">Detalle de la Reserva</h3>

    @if (TempData["Mensaje"] != null)
    {
        <div class="alert alert-danger">@TempData["Mensaje"]</div>
    }

    @if (ViewBag.Mensaje != null)
    {
        <div class="alert alert-danger">@ViewBag.Mensaje</div>
    }

    <div class="row">
        <div class="col-md-6 mb-3">
            <div class="detalle-label">Cliente</div>
            <div class="detalle-valor">@MostrarTexto(Model.Cliente)</div>
        </div>
        <div class="col-md-6 mb-3">
            <div class="detalle-label">Código de seguridad</div>
            <div class="detalle-valor">
                <strong>@Model.CodigoSeguridad</strong>
            </div>
        </div>
        <div class="col-md-6 mb-3">
            <div class="detalle-label">Empresa de procedencia</div>
            <div class="detalle-valor">@MostrarTexto(Model.EmpresaProcedencia)</div>
        </div>
        <div class="col-md-6 mb-3">
            <div class="detalle-label">Habitación</div>
            <div class="detalle-valor">Habitación @MostrarTexto(Model.Habitacion)</div>
        </div>

        <div class="col-md-6 mb-3">
            <div class="detalle-label">Fecha de entrada</div>
            <div class="detalle-valor">@Model.FechaEntrada.ToString("dd/MM/yyyy")</div>
        </div>

        <div class="col-md-6 mb-3">
            <div class="detalle-label">Fecha de salida</div>
            <div class="detalle-valor">@Model.FechaSalida.ToString("dd/MM/yyyy")</div>
        </div>

        <div class="col-md-6 mb-3">
            <div class="detalle-label">Check-in realizado</div>
            <div class="detalle-valor">@(Model.FechaHoraCheckIn?.ToString("dd/MM/yyyy HH:mm") ?? "-")</div>
        </div>

        <div class="col-md-6 mb-3">
            <div class="detalle-label">Check-out realizado</div>
            <div class="detalle-valor">@(Model.FechaHoraCheckOut?.ToString("dd/MM/yyyy HH:mm") ?? "-")</div>
        </div>

        <div class="col-md-6 mb-3">
            <div class="detalle-label">Cantidad de personas</div>
            <div class="detalle-valor">@Model.CantidadPersonas</div>
        </div>

        <div class="col-md-6 mb-3">
            <div class="detalle-label">Total reserva</div>
            <div class="detalle-valor">Q @Model.TotalReserva.ToString("N2")</div>
        </div>

        <div class="col-md-6 mb-3">
            <div class="detalle-label">Total pagado</div>
            <div class="detalle-valor">Q @Model.TotalPagado.ToString("N2")</div>
        </div>

        <div class="col-md-6 mb-3">
            <div class="detalle-label">Pago pendiente</div>
            <div class="detalle-valor">Q @Model.SaldoPendiente.ToString("N2")</div>
        </div>

        <div class="col-md-6 mb-3">
            <div class="detalle-label">Estado</div>
            <div class="detalle-valor">
                @{
                    string estado = (Model.Estado ?? "").Trim().ToLower();
                }

                @if (estado == "pendiente")
                {
                    <span class="estado-pendiente">Pendiente de ingreso</span>
                }
                else if (estado == "en_curso")
                {
                    <span class="estado-en_curso">En curso</span>
                }
                else if (estado == "en_checkout")
                {
                    <span class="estado-en_checkout">En check-out</span>
                }
                else if (estado == "cancelada")
                {
                    <span class="estado-cancelada">Cancelada</span>
                }
                else if (estado == "finalizada")
                {
                    <span class="estado-finalizada">Finalizada</span>
                }
            </div>
        </div>

        <div class="col-12 mb-3">
            <div class="detalle-label">Observaciones</div>
            <div class="detalle-valor">@MostrarTexto(Model.Observaciones)</div>
        </div>
    </div>

    @if (Model.IdReservaGrupo.HasValue && Model.ReservasDelGrupo.Count > 0)
    {
        <div class="reserva-grupo-panel">
            <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
                <div>
                    <h5 class="mb-1">Fechas de la reserva agrupada #@Model.IdReservaGrupo</h5>
                    <span class="text-muted">Cada fila conserva su propio estado, saldo y proceso de check-in.</span>
                </div>
                <strong>Total del grupo: Q @Model.ReservasDelGrupo.Sum(r => r.TotalReserva).ToString("N2")</strong>
            </div>

            <div class="table-responsive">
                <table class="table table-bordered align-middle mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th>Entrada</th>
                            <th>Salida</th>
                            <th>Habitación</th>
                            <th>Total</th>
                            <th>Saldo</th>
                            <th>Estado</th>
                            <th>Acción</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var reservaGrupo in Model.ReservasDelGrupo)
                        {
                            <tr class="@(reservaGrupo.IdReserva == Model.IdReserva ? "fila-reserva-actual" : "")">
                                <td>@reservaGrupo.FechaEntrada.ToString("dd/MM/yyyy")</td>
                                <td>@reservaGrupo.FechaSalida.ToString("dd/MM/yyyy")</td>
                                <td>@reservaGrupo.Habitacion</td>
                                <td>Q @reservaGrupo.TotalReserva.ToString("N2")</td>
                                <td>Q @reservaGrupo.SaldoPendiente.ToString("N2")</td>
                                <td>@MostrarEstado(reservaGrupo.Estado)</td>
                                <td>
                                    @if (reservaGrupo.IdReserva == Model.IdReserva)
                                    {
                                        <span class="text-muted">Actual</span>
                                    }
                                    else
                                    {
                                        <a asp-controller="Reservas" asp-action="Detalle" asp-route-id="@reservaGrupo.IdReserva" class="btn-cuenta py-1 px-2">Ver</a>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

    <div class="acciones-formulario">
        <a asp-controller="CuentasPorCobrar" asp-action="Detalle" asp-route-id="@Model.IdReserva" class="btn-cuenta">
            Ver cuenta y abonos
        </a>
        <a asp-controller="Reservas" asp-action="Index" class="btn-volver">
            Volver al listado
        </a>
    </div>
</div>
