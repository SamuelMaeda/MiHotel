@{
    ViewData["Title"] = "Buscar Reserva por Código";
}

<style>
    .tarjeta {
        background-color: white;
        border-radius: 15px;
        padding: 25px;
        box-shadow: 0 4px 10px rgba(0,0,0,0.10);
        max-width: 500px;
        margin: auto;
    }

    .form-control {
        border-radius: 8px;
        height: 40px;
    }

    .btn-buscar {
        background-color: #464482;
        color: white;
        border: none;
        padding: 10px 18px;
        border-radius: 8px;
    }

        .btn-buscar:hover {
            background-color: #36366b;
        }
</style>

<div class="container py-4">
    <div class="tarjeta mh-page-shell mh-page-shell--compact">
        <div class="mh-page-header">
            <div><h4>Buscar reserva</h4><p>Ingrese el código de seguridad entregado al crear la reservación.</p></div>
        </div>

        @if (ViewBag.Mensaje != null)
        {
            <div class="alert alert-danger">
                @ViewBag.Mensaje
            </div>
        }

        <form method="post">
            <div class="mb-3">
                <label>Código de seguridad</label>
                <input type="text" name="codigo" class="form-control" placeholder="Ej: RES-15-H3-142530-483" />
            </div>

            <div class="mh-bottom-actions">
                <a asp-controller="Panel" asp-action="Index" class="mh-btn mh-btn-back" title="Regresar al panel principal"><i class="bi bi-arrow-left-circle-fill"></i> Volver al panel</a>
                <button type="submit" class="btn-buscar mh-btn mh-btn-primary" title="Buscar una reserva mediante su código"><i class="bi bi-search"></i> Buscar reserva</button>
            </div>
        </form>
    </div>
</div>
