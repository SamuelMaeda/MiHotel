@model System.Data.DataTable

@{
    ViewData["Title"] = "Reservas";

    string busqueda = ViewBag.Busqueda ?? "";
    string ordenarPor = ViewBag.OrdenarPor ?? "fecha_entrada";
    string direccion = ViewBag.Direccion ?? "desc";
    string vista = ViewBag.Vista ?? "pendiente";
    int paginaActual = ViewBag.PaginaActual ?? 1;
    int totalPaginas = ViewBag.TotalPaginas ?? 1;
    int totalRegistros = ViewBag.TotalRegistros ?? 0;
    int reservasPendientesVencidas = ViewBag.ReservasPendientesVencidas ?? 0;
    bool mostrarHoras = vista is "finalizada" or "pendientes_factura";
    bool mostrarLimpieza = vista is "pendiente" or "en_curso";
    int? reservaReembolsoPendiente = TempData["ReservaReembolsoPendiente"] == null
        ? null
        : Convert.ToInt32(TempData["ReservaReembolsoPendiente"]);
    decimal montoReembolsoPendiente = decimal.TryParse(
        TempData["MontoReembolsoPendiente"]?.ToString(),
        System.Globalization.NumberStyles.Number,
        System.Globalization.CultureInfo.InvariantCulture,
        out decimal montoReembolso)
            ? montoReembolso
            : 0;

    string SiguienteDireccion(string columna)
    {
        if (ordenarPor == columna && direccion == "asc")
        {
            return "desc";
        }
        return "asc";
    }

    string IconoOrden(string columna)
    {
        if (ordenarPor != columna)
        {
            return "bi-arrow-down-up";
        }
        return direccion == "asc" ? "bi-sort-alpha-down" : "bi-sort-alpha-up";
    }
}

<style>
    .tarjeta-contenido {
        background-color: white;
        border-radius: 15px;
        padding: 25px;
        box-shadow: 0 4px 10px rgba(0,0,0,0.10);
    }

    .btn-crear {
        background-color: #464482;
        color: white;
        padding: 10px 16px;
        border-radius: 8px;
        text-decoration: none;
        font-weight: 500;
    }

    .tabs-vista {
        display: flex;
        gap: 10px;
        margin-bottom: 20px;
        flex-wrap: wrap;
    }

    .tab-vista {
        text-decoration: none;
        padding: 10px 14px;
        border-radius: 8px;
        background-color: #E6D3D0;
        color: #363636;
        font-weight: 500;
    }

        .tab-vista.activa {
            background-color: #824B44;
            color: white;
        }

    .paginacion {
        display: flex;
        gap: 8px;
        flex-wrap: wrap;
        margin-top: 20px;
    }

    .pagina-link {
        padding: 8px 12px;
        border-radius: 8px;
        text-decoration: none;
        background-color: #E6D3D0;
        color: #363636;
    }

        .pagina-link.activa {
            background-color: #464482;
            color: white;
            font-weight: bold;
        }

    .encabezado-orden {
        color: inherit;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        font-weight: 600;
    }

    .acciones-contenedor {
        display: flex;
        gap: 8px;
        flex-wrap: wrap;
    }

    .btn-icono {
        width: 38px;
        height: 38px;
        border-radius: 8px;
        border: none;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        color: white;
        text-decoration: none;
        font-size: 16px;
    }

    .btn-detalle {
        background-color: #464482;
    }

    .btn-editar {
        background-color: #824B44;
    }

    .btn-checkin {
        background-color: #0d6efd;
    }

    .btn-checkout {
        background-color: #fd7e14;
    }

    .btn-cancelar {
        background-color: #6e3f39;
    }

    .estado-pendiente {
        color: #856404;
        font-weight: bold;
    }

    .estado-en_curso {
        color: #0c5460;
        font-weight: bold;
    }

    .estado-en_checkout {
        color: #b45309;
        font-weight: bold;
    }

    .estado-cancelada {
        color: #842029;
        font-weight: bold;
    }

    .estado-finalizada {
        color: #0c5460;
        font-weight: bold;
    }

    .form-accion {
        display: inline;
    }

    .etiqueta-grupo {
        display: inline-block;
        margin-top: 4px;
        padding: 2px 7px;
        border-radius: 999px;
        background-color: #e6d3d0;
        color: #824b44;
        font-size: 0.78rem;
        font-weight: 600;
    }

    .indicador-factura {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 27px;
        height: 27px;
        margin-left: 6px;
        border-radius: 50%;
        background-color: #d9f2df;
        color: #17652b;
        vertical-align: middle;
    }

    .indicador-factura-pendiente {
        background-color: #fff0c9;
        color: #885b00;
    }

    .indicador-tarjeta {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 27px;
        height: 27px;
        margin-left: 6px;
        border-radius: 50%;
        background-color: #e3e2f3;
        color: #464482;
        vertical-align: middle;
    }
</style>

<div class="tarjeta-contenido mh-page-shell">
    <div class="mh-page-header">
        <div>
            <h3>Gestión de Reservas</h3>
            <p>Consulta y administra las estadías registradas en el hotel.</p>
        </div>
        <a asp-controller="Reservas" asp-action="Crear" class="btn-crear mh-btn mh-btn-primary" title="Crear una nueva reservación">
            <i class="bi bi-calendar-plus-fill"></i> Nueva reserva
        </a>
    </div>

    <div class="tabs-vista">
        <a asp-controller="Reservas" asp-action="Index" asp-route-vista="todas" asp-route-busqueda="@busqueda" asp-route-ordenarPor="@ordenarPor" asp-route-direccion="@direccion" class="tab-vista @(vista == "todas" ? "activa" : "")" title="Mostrar todas las reservas"><i class="bi bi-grid-fill me-1"></i>Todas</a>
        <a asp-controller="Reservas" asp-action="Index" asp-route-vista="pendiente" asp-route-busqueda="@busqueda" asp-route-ordenarPor="@ordenarPor" asp-route-direccion="@direccion" class="tab-vista @(vista == "pendiente" ? "activa" : "")" title="Mostrar reservas pendientes de ingreso"><i class="bi bi-hourglass-split me-1"></i>Pendientes de ingreso</a>
        <a asp-controller="Reservas" asp-action="Index" asp-route-vista="en_curso" asp-route-busqueda="@busqueda" asp-route-ordenarPor="@ordenarPor" asp-route-direccion="@direccion" class="tab-vista @(vista == "en_curso" ? "activa" : "")" title="Mostrar estadías en curso"><i class="bi bi-door-open-fill me-1"></i>En curso</a>
        <a asp-controller="Reservas" asp-action="Index" asp-route-vista="en_checkout" asp-route-busqueda="@busqueda" asp-route-ordenarPor="@ordenarPor" asp-route-direccion="@direccion" class="tab-vista @(vista == "en_checkout" ? "activa" : "")" title="Mostrar estadías en proceso de salida"><i class="bi bi-box-arrow-right me-1"></i>En check-out</a>
        <a asp-controller="Reservas" asp-action="Index" asp-route-vista="finalizada" asp-route-busqueda="@busqueda" asp-route-ordenarPor="@ordenarPor" asp-route-direccion="@direccion" class="tab-vista @(vista == "finalizada" ? "activa" : "")" title="Mostrar estadías finalizadas"><i class="bi bi-check-circle-fill me-1"></i>Finalizadas</a>
        <a asp-controller="Reservas" asp-action="Index" asp-route-vista="pendientes_factura" asp-route-busqueda="@busqueda" asp-route-ordenarPor="@ordenarPor" asp-route-direccion="@direccion" class="tab-vista @(vista == "pendientes_factura" ? "activa" : "")" title="Mostrar reservas pendientes de factura"><i class="bi bi-receipt me-1"></i>Pendientes de factura</a>
        <a asp-controller="Reservas" asp-action="Index" asp-route-vista="cancelada" asp-route-busqueda="@busqueda" asp-route-ordenarPor="@ordenarPor" asp-route-direccion="@direccion" class="tab-vista @(vista == "cancelada" ? "activa" : "")" title="Mostrar reservas canceladas"><i class="bi bi-x-circle-fill me-1"></i>Canceladas</a>
    </div>

    @if (TempData["Exito"] != null)
    {
        <div class="alert alert-success">@TempData["Exito"]</div>
    }

    @if (TempData["Mensaje"] != null)
    {
        <div class="alert alert-danger">@TempData["Mensaje"]</div>
    }

    @if (reservaReembolsoPendiente.HasValue && montoReembolsoPendiente > 0)
    {
        <div class="alert alert-warning">
            <strong>Esta cancelación requiere devolver dinero al huésped.</strong>
            <div class="mt-1 mb-3">
                Se registrará un reembolso de <strong>Q @montoReembolsoPendiente.ToString("N2")</strong>
                antes de cancelar la reservación #@reservaReembolsoPendiente.Value.
            </div>
            <form asp-controller="Reservas" asp-action="Cancelar" asp-route-id="@reservaReembolsoPendiente.Value" method="post"
                  onsubmit="return confirm('¿Confirma que el dinero fue devuelto al huésped y desea registrar el reembolso? Esta acción no se puede deshacer desde esta pantalla.');">
                @Html.AntiForgeryToken()
                <input type="hidden" name="registrarReembolso" value="true" />
                <button type="submit" class="mh-btn mh-btn-cancel" title="Registrar el reembolso y cancelar esta reserva">
                    <i class="bi bi-cash-stack me-1"></i> Registrar reembolso y cancelar
                </button>
            </form>
        </div>
    }

    @if (reservasPendientesVencidas > 0)
    {
        <div class="alert alert-warning d-flex align-items-start gap-2">
            <i class="bi bi-exclamation-triangle-fill mt-1"></i>
            <div>
                <strong>@reservasPendientesVencidas reservación(es) no registraron check-in en la fecha prevista.</strong>
                Revise las pendientes de ingreso y cancele manualmente las que no se presentaron.
            </div>
        </div>
    }

    <form id="formBusqueda" asp-controller="Reservas" asp-action="Index" method="get" class="mb-4">
        <input type="hidden" name="vista" value="@vista" />
        <input type="hidden" name="ordenarPor" value="@ordenarPor" />
        <input type="hidden" name="direccion" value="@direccion" />

        <label class="form-label">Buscar reserva</label>
        <input type="text" id="busqueda" name="busqueda" value="@busqueda" class="form-control" placeholder="Buscar por cliente, empresa, habitación, grupo u observaciones" />
    </form>

    <div class="mb-3">
        <strong>Total de registros:</strong> @totalRegistros
    </div>

    <div class="table-responsive">
        <table class="table table-bordered table-striped mh-table @(vista == "pendiente" ? "" : "tabla-reservas")">
            <thead class="table-dark">
                <tr>
                    <th>
                        <a asp-controller="Reservas" asp-action="Index" asp-route-busqueda="@busqueda" asp-route-ordenarPor="cliente" asp-route-direccion="@SiguienteDireccion("cliente")" asp-route-vista="@vista" class="encabezado-orden">
                            Cliente <i class="bi @IconoOrden("cliente")"></i>
                        </a>
                    </th>
                    <th>
                        <a asp-controller="Reservas" asp-action="Index" asp-route-busqueda="@busqueda" asp-route-ordenarPor="empresa" asp-route-direccion="@SiguienteDireccion("empresa")" asp-route-vista="@vista" class="encabezado-orden">
                            Empresa <i class="bi @IconoOrden("empresa")"></i>
                        </a>
                    </th>
                    <th>
                        <a asp-controller="Reservas" asp-action="Index" asp-route-busqueda="@busqueda" asp-route-ordenarPor="habitacion" asp-route-direccion="@SiguienteDireccion("habitacion")" asp-route-vista="@vista" class="encabezado-orden">
                            Habitación <i class="bi @IconoOrden("habitacion")"></i>
                        </a>
                    </th>
                    <th>
                        <a asp-controller="Reservas" asp-action="Index" asp-route-busqueda="@busqueda" asp-route-ordenarPor="fecha_entrada" asp-route-direccion="@SiguienteDireccion("fecha_entrada")" asp-route-vista="@vista" class="encabezado-orden">
                            Entrada <i class="bi @IconoOrden("fecha_entrada")"></i>
                        </a>
                    </th>
                    <th>
                        <a asp-controller="Reservas" asp-action="Index" asp-route-busqueda="@busqueda" asp-route-ordenarPor="fecha_salida" asp-route-direccion="@SiguienteDireccion("fecha_salida")" asp-route-vista="@vista" class="encabezado-orden">
                            Salida <i class="bi @IconoOrden("fecha_salida")"></i>
                        </a>
                    </th>
                    @if (mostrarHoras)
                    {
                        <th>
                            <a asp-controller="Reservas" asp-action="Index" asp-route-busqueda="@busqueda" asp-route-ordenarPor="hora_checkin" asp-route-direccion="@SiguienteDireccion("hora_checkin")" asp-route-vista="@vista" class="encabezado-orden">
                                Hora de check-in <i class="bi @IconoOrden("hora_checkin")"></i>
                            </a>
                        </th>
                        <th>
                            <a asp-controller="Reservas" asp-action="Index" asp-route-busqueda="@busqueda" asp-route-ordenarPor="hora_checkout" asp-route-direccion="@SiguienteDireccion("hora_checkout")" asp-route-vista="@vista" class="encabezado-orden">
                                Hora de check-out <i class="bi @IconoOrden("hora_checkout")"></i>
                            </a>
                        </th>
                    }
                    <th>
                        <a asp-controller="Reservas" asp-action="Index" asp-route-busqueda="@busqueda" asp-route-ordenarPor="total" asp-route-direccion="@SiguienteDireccion("total")" asp-route-vista="@vista" class="encabezado-orden">
                            Total <i class="bi @IconoOrden("total")"></i>
                        </a>
                    </th>
                    <th>
                        <a asp-controller="Reservas" asp-action="Index" asp-route-busqueda="@busqueda" asp-route-ordenarPor="saldo" asp-route-direccion="@SiguienteDireccion("saldo")" asp-route-vista="@vista" class="encabezado-orden">
                            Pago pendiente <i class="bi @IconoOrden("saldo")"></i>
                        </a>
                    </th>
                    @if (mostrarLimpieza)
                    {
                        <th>
                            <a asp-controller="Reservas" asp-action="Index" asp-route-busqueda="@busqueda" asp-route-ordenarPor="limpieza" asp-route-direccion="@SiguienteDireccion("limpieza")" asp-route-vista="@vista" class="encabezado-orden">
                                Limpieza <i class="bi @IconoOrden("limpieza")"></i>
                            </a>
                        </th>
                    }
                    <th>
                        <a asp-controller="Reservas" asp-action="Index" asp-route-busqueda="@busqueda" asp-route-ordenarPor="estado" asp-route-direccion="@SiguienteDireccion("estado")" asp-route-vista="@vista" class="encabezado-orden">
                            Estado <i class="bi @IconoOrden("estado")"></i>
                        </a>
                    </th>
                    <th>Acciones</th>
                </tr>
            </thead>

            <tbody>
                @if (Model.Rows.Count == 0)
                {
                    <tr>
                        <td colspan="@(9 + (mostrarHoras ? 2 : 0) + (mostrarLimpieza ? 1 : 0))" class="mh-empty-state"><i class="bi bi-calendar-x me-2"></i>No se encontraron reservas.</td>
                    </tr>
                }
                else
                {
                    foreach (System.Data.DataRow fila in Model.Rows)
                    {
                        string estado = fila["estado"]?.ToString()?.Trim().ToLower() ?? "";
                        string estadoFacturacion = fila["estado_facturacion"]?.ToString()?.Trim().ToLower() ?? "sin_definir";
                        bool tieneFactura = Convert.ToBoolean(fila["tiene_factura"]);
                        bool pagoConTarjeta = Convert.ToBoolean(fila["pago_con_tarjeta"]);
                        bool fechaIngresoVencida = estado == "pendiente"
                            && Convert.ToDateTime(fila["fecha_entrada"]).Date < DateTime.Today;
                        bool fechaIngresoHoy = estado == "pendiente"
                            && Convert.ToDateTime(fila["fecha_entrada"]).Date == DateTime.Today;
                        bool fechaIngresoFutura = estado == "pendiente"
                            && Convert.ToDateTime(fila["fecha_entrada"]).Date > DateTime.Today;

                        <tr>
                            <td>
                                <div>@fila["nombre"]</div>
                                @if (fila["id_reserva_grupo"] != DBNull.Value)
                                {
                                    <span class="etiqueta-grupo">Grupo #@fila["id_reserva_grupo"]</span>
                                }
                            </td>
                            <td>@(fila["empresa_procedencia"] == DBNull.Value ? "-" : fila["empresa_procedencia"])</td>
                            <td>@fila["habitacion"]</td>
                            <td>@Convert.ToDateTime(fila["fecha_entrada"]).ToString("dd/MM/yyyy")</td>
                            <td>@Convert.ToDateTime(fila["fecha_salida"]).ToString("dd/MM/yyyy")</td>
                            @if (mostrarHoras)
                            {
                                <td>@(fila["fecha_hora_checkin"] == DBNull.Value ? "-" : Convert.ToDateTime(fila["fecha_hora_checkin"]).ToString("HH:mm"))</td>
                                <td>@(fila["fecha_hora_checkout"] == DBNull.Value ? "-" : Convert.ToDateTime(fila["fecha_hora_checkout"]).ToString("HH:mm"))</td>
                            }
                            <td class="celda-moneda">Q @Convert.ToDecimal(fila["total_reserva"]).ToString("N2")</td>
                            <td class="celda-moneda">Q @Convert.ToDecimal(fila["saldo_pendiente"]).ToString("N2")</td>
                            @if (mostrarLimpieza)
                            {
                                <td>@(Convert.ToBoolean(fila["solicita_limpieza"]) ? "Sí" : "No")</td>
                            }

                            <td class="celda-estado">
                                @if (estado == "pendiente")
                                {
                                    <span class="estado-pendiente">
                                        @(fechaIngresoVencida ? "Pendiente de ingreso — fecha vencida" : "Pendiente de ingreso")
                                    </span>
                                    @if (fechaIngresoFutura)
                                    {
                                        <small class="d-block text-muted mt-1">
                                            Check-in disponible el @Convert.ToDateTime(fila["fecha_entrada"]).ToString("dd/MM/yyyy")
                                        </small>
                                    }
                                }
                                else if (estado == "en_curso")
                                {
                                    <span class="estado-en_curso">En curso</span>
                                }
                                else if (estado == "en_checkout")
                                {
                                    <span class="estado-en_checkout">En check-out</span>
                                }
                                else if (estado == "cancelada")
                                {
                                    <span class="estado-cancelada">Cancelada</span>
                                }
                                else if (estado == "finalizada")
                                {
                                    <span class="estado-finalizada">Finalizada</span>
                                }
                                @if (tieneFactura)
                                {
                                    <span class="indicador-factura" title="Factura adjunta" aria-label="Factura adjunta">
                                        <i class="bi bi-receipt-cutoff"></i>
                                    </span>
                                }
                                else if (estadoFacturacion is "pendiente" or "anulada")
                                {
                                    <span class="indicador-factura indicador-factura-pendiente" title="Factura pendiente de adjuntar" aria-label="Factura pendiente de adjuntar">
                                        <i class="bi bi-hourglass-split"></i>
                                    </span>
                                }
                                @if (pagoConTarjeta)
                                {
                                    <span class="indicador-tarjeta" title="Pago realizado con tarjeta" aria-label="Pago realizado con tarjeta">
                                        <i class="bi bi-credit-card-fill"></i>
                                    </span>
                                }
                            </td>

                            <td>
                                <div class="acciones-contenedor">
                                    <a asp-controller="Reservas" asp-action="Detalle" asp-route-id="@fila["id_reserva"]" class="btn-icono btn-detalle mh-icon-button mh-icon-view" title="Ver el detalle de la reserva" aria-label="Ver el detalle de la reserva">
                                        <i class="bi bi-eye-fill"></i>
                                    </a>

                                    @if (vista == "pendientes_factura" && (estadoFacturacion is "pendiente" or "anulada"))
                                    {
                                        <form asp-controller="Facturas" asp-action="CancelarSolicitud" method="post" class="form-accion"
                                              onsubmit="return confirm('¿Confirma que el huésped ya no necesita factura? La reservación saldrá de Facturas pendientes.');">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="idReserva" value="@fila["id_reserva"]" />
                                            <input type="hidden" name="retorno" value="reservas" />
                                            <input type="hidden" name="busqueda" value="@busqueda" />
                                            <button type="submit" class="btn-icono btn-cancelar mh-icon-button mh-icon-cancel" title="Cancelar la solicitud de factura" aria-label="Cancelar la solicitud de factura">
                                                <i class="bi bi-x-circle-fill"></i>
                                            </button>
                                        </form>
                                    }


                                    @if (estado == "pendiente")
                                    {
                                        <a asp-controller="Reservas" asp-action="Editar" asp-route-id="@fila["id_reserva"]" class="btn-icono btn-editar mh-icon-button mh-icon-edit" title="Editar esta reserva" aria-label="Editar esta reserva">
                                            <i class="bi bi-pencil-fill"></i>
                                        </a>
                                    }

                                    @if (fechaIngresoHoy)
                                    {
                                        <form asp-controller="Reservas" asp-action="CheckIn" asp-route-id="@fila["id_reserva"]" method="post" class="form-accion">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn-icono btn-checkin mh-icon-button mh-icon-positive" title="Realizar el check-in de esta reserva" aria-label="Realizar el check-in de esta reserva">
                                                <i class="bi bi-box-arrow-in-right"></i>
                                            </button>
                                        </form>
                                    }

                                    @if (estado == "en_curso")
                                    {
                                        <form asp-controller="Reservas" asp-action="IniciarCheckout" asp-route-id="@fila["id_reserva"]" method="post" class="form-accion">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn-icono btn-checkout mh-icon-button mh-icon-positive" title="Iniciar el check-out de esta estadía" aria-label="Iniciar el check-out de esta estadía">
                                                <i class="bi bi-box-arrow-right"></i>
                                            </button>
                                        </form>
                                    }

                                    @if (estado == "en_checkout")
                                    {
                                        <a asp-controller="Reservas" asp-action="Checkout" asp-route-id="@fila["id_reserva"]" class="btn-icono btn-checkout mh-icon-button mh-icon-positive" title="Continuar el check-out de esta estadía" aria-label="Continuar el check-out de esta estadía">
                                            <i class="bi bi-cash-coin"></i>
                                        </a>
                                    }

                                    @if (estado == "pendiente")
                                    {
                                        <form asp-controller="Reservas" asp-action="Cancelar" asp-route-id="@fila["id_reserva"]" method="post" class="form-accion">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn-icono btn-cancelar mh-icon-button mh-icon-cancel" title="Cancelar esta reserva" aria-label="Cancelar esta reserva">
                                                <i class="bi bi-x-circle-fill"></i>
                                            </button>
                                        </form>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    @if (totalPaginas > 1)
    {
        <div class="paginacion">
            @for (int i = 1; i <= totalPaginas; i++)
            {
                <a asp-controller="Reservas" asp-action="Index" asp-route-busqueda="@busqueda" asp-route-ordenarPor="@ordenarPor" asp-route-direccion="@direccion" asp-route-vista="@vista" asp-route-pagina="@i" class="pagina-link @(i == paginaActual ? "activa" : "")" title="Ir a la página @i" aria-current="@(i == paginaActual ? "page" : null)">
                    @i
                </a>
            }
        </div>
    }
</div>

@section Scripts {
    <script>
        let temporizador;

        document.getElementById("busqueda").addEventListener("input", function () {
            clearTimeout(temporizador);
            temporizador = setTimeout(function () {
                document.getElementById("formBusqueda").submit();
            }, 350);
        });
    </script>
}
