@model MiHotel.Models.CheckoutReservaViewModel

@{
    ViewData["Title"] = "Check-out de la estadía";
    bool cuentaPagada = Model.SaldoPendiente <= 0;
    bool cuentaAgrupadaPagada = Model.SaldoPendienteGrupo <= 0;
    bool esCierreIntermedio = Model.EsReservaAgrupada && !Model.EsUltimaEstadiaGrupo;
    bool puedeFinalizarDirectamente = esCierreIntermedio || (Model.EsReservaAgrupada ? cuentaAgrupadaPagada : cuentaPagada);
}

<style>
    .tarjeta-contenido {
        background-color: white;
        border-radius: 15px;
        padding: 25px;
        box-shadow: 0 4px 10px rgba(0,0,0,0.10);
    }

    .resumen-checkout {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(190px, 1fr));
        gap: 14px;
        margin-bottom: 22px;
    }

    .dato-resumen {
        background-color: #f5efee;
        border: 1px solid #e6d3d0;
        border-radius: 10px;
        padding: 14px;
    }

    .dato-resumen span {
        color: #6c757d;
        display: block;
        font-size: 13px;
        margin-bottom: 4px;
    }

    .saldo-pendiente {
        color: #842029;
        font-size: 1.35rem;
        font-weight: 700;
    }

    .saldo-pagado {
        color: #146c43;
        font-size: 1.35rem;
        font-weight: 700;
    }

    .acciones-checkout {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        margin-top: 20px;
    }

    .btn-checkout {
        border: none;
        border-radius: 8px;
        color: white;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 10px 16px;
        text-decoration: none;
        font-weight: 500;
    }

    .btn-checkout:hover { color: white; }
    .btn-pagar { background-color: #464482; }
    .btn-finalizar { background-color: #198754; }
    .btn-regresar { background-color: #824B44; }

    .decision-factura {
        margin-top: 22px;
        padding: 18px;
        border: 1px solid #d8c5c2;
        border-radius: 10px;
        background-color: #fff9f8;
    }

    .opciones-factura { display: flex; flex-wrap: wrap; gap: 18px; margin-top: 12px; }

</style>

<div class="tarjeta-contenido">
    <div class="d-flex justify-content-between align-items-start flex-wrap gap-2 mb-4">
        <div>
            <h3 class="mb-1">Check-out de la reservación #@Model.IdReserva</h3>
            <p class="text-muted mb-0">
                @if (Model.EsReservaAgrupada)
                {
                    <text>Esta estadía pertenece al grupo #@Model.IdReservaGrupo. Los pagos se administran en una sola cuenta agrupada.</text>
                }
                else
                {
                    <text>Revise la cuenta y registre los pagos antes de finalizar la estadía.</text>
                }
            </p>
        </div>
        <span class="badge rounded-pill text-bg-warning px-3 py-2">En check-out</span>
    </div>

    <section class="decision-factura" aria-labelledby="tituloDecisionFactura">
        <h5 id="tituloDecisionFactura" class="mb-1">Decisión de facturación</h5>
        <p class="text-muted mb-0">Debe indicar expresamente si el huésped solicitó factura para esta estadía.</p>
        <div class="opciones-factura">
            <div class="form-check">
                <input class="form-check-input decision-factura-opcion" type="radio" name="decisionFacturaVisual" id="requiereFacturaSi" value="true" />
                <label class="form-check-label" for="requiereFacturaSi">Sí, requiere factura</label>
            </div>
            <div class="form-check">
                <input class="form-check-input decision-factura-opcion" type="radio" name="decisionFacturaVisual" id="requiereFacturaNo" value="false" />
                <label class="form-check-label" for="requiereFacturaNo">No requiere factura</label>
            </div>
        </div>
        <div id="avisoDecisionFactura" class="form-text">Ninguna opción se selecciona automáticamente.</div>
    </section>

    @if (TempData["Exito"] != null)
    {
        <div class="alert alert-success">@TempData["Exito"]</div>
    }

    @if (TempData["Mensaje"] != null)
    {
        <div class="alert alert-danger">@TempData["Mensaje"]</div>
    }

    <div class="resumen-checkout">
        <div class="dato-resumen"><span>Cliente</span><strong>@Model.Cliente</strong></div>
        <div class="dato-resumen"><span>Empresa de procedencia</span><strong>@(string.IsNullOrWhiteSpace(Model.EmpresaProcedencia) ? "-" : Model.EmpresaProcedencia)</strong></div>
        <div class="dato-resumen"><span>Habitación</span><strong>@Model.Habitacion</strong></div>
        <div class="dato-resumen"><span>Entrada</span><strong>@Model.FechaEntrada.ToString("dd/MM/yyyy")</strong></div>
        <div class="dato-resumen"><span>Check-in realizado</span><strong>@(Model.FechaHoraCheckIn?.ToString("dd/MM/yyyy HH:mm") ?? "-")</strong></div>
        <div class="dato-resumen"><span>Salida</span><strong>@Model.FechaSalida.ToString("dd/MM/yyyy")</strong></div>
        <div class="dato-resumen"><span>Total de hospedaje</span><strong>Q @Model.TotalReserva.ToString("N2")</strong></div>
        <div class="dato-resumen">
            <span>Saldo de esta estadía</span>
            <strong class="@(cuentaPagada ? "saldo-pagado" : "saldo-pendiente")">Q @Model.SaldoPendiente.ToString("N2")</strong>
        </div>
        @if (Model.EsReservaAgrupada)
        {
            <div class="dato-resumen">
                <span>Saldo total de la reserva agrupada</span>
                <strong class="@(cuentaAgrupadaPagada ? "saldo-pagado" : "saldo-pendiente")">Q @Model.SaldoPendienteGrupo.ToString("N2")</strong>
            </div>
        }
    </div>

    @if (esCierreIntermedio && Model.SaldoPendienteGrupo > 0)
    {
        <div class="alert alert-info">
            Esta es una estadía intermedia. Puede finalizarla sin liquidar ahora; el saldo continuará en la cuenta agrupada.
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(Model.Observaciones))
    {
        <div class="alert alert-light border"><strong>Observaciones:</strong> @Model.Observaciones</div>
    }

    <h5 class="mt-4">Movimientos de la cuenta</h5>
    <div class="table-responsive">
        <table class="table table-bordered table-striped align-middle">
            <thead class="table-dark">
                <tr>
                    <th>Fecha</th>
                    <th>Movimiento</th>
                    <th>Forma de pago</th>
                    <th>Abono</th>
                    <th>Recargo</th>
                    <th>Total cobrado</th>
                    <th>Estado</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Movimientos.Count == 0)
                {
                    <tr><td colspan="7" class="text-center py-3">No hay movimientos registrados.</td></tr>
                }
                else
                {
                    foreach (var movimiento in Model.Movimientos)
                    {
                        <tr>
                            <td>@movimiento.FechaHora.ToString("dd/MM/yyyy HH:mm")</td>
                            <td>@movimiento.MovimientoLegible</td>
                            <td>@movimiento.FormaPagoLegible</td>
                            <td>Q @movimiento.Monto.ToString("N2")</td>
                            <td>@(movimiento.RecargoTarjeta > 0 ? $"Q {movimiento.RecargoTarjeta:N2}" : "—")</td>
                            <td>Q @movimiento.TotalCobrado.ToString("N2")</td>
                            <td>@(movimiento.Estado.Trim().ToLower() == "activo" ? "Activo" : "Anulado")</td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    <div class="acciones-checkout">
        <a asp-controller="CuentasPorCobrar" asp-action="Detalle" asp-route-id="@Model.IdReserva" class="btn-checkout btn-pagar">
            <i class="bi bi-cash-coin"></i>
            @(Model.EsReservaAgrupada
                ? "Pagar esta estadía o la cuenta agrupada"
                : cuentaPagada ? "Consultar o corregir abonos" : "Registrar o corregir abonos")
        </a>

        <form asp-controller="Reservas" asp-action="RegresarEnCurso" asp-route-id="@Model.IdReserva" method="post">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn-checkout btn-regresar" onclick="return confirm('¿Desea cancelar el check-out y permitir nuevamente consumos en la estadía?');">
                <i class="bi bi-arrow-left-circle"></i> Regresar a en curso
            </button>
        </form>

        @if (puedeFinalizarDirectamente)
        {
            <form asp-controller="Reservas" asp-action="FinalizarEstadia" asp-route-id="@Model.IdReserva" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" class="valor-requiere-factura" name="requiereFactura" />
                <button type="submit" class="btn-checkout btn-finalizar boton-finalizar-estadia" disabled onclick="return confirm('¿Desea registrar la salida y liberar la habitación?');">
                    <i class="bi bi-check-circle"></i> <span class="texto-finalizar">Finalizar estadía</span>
                </button>
            </form>
        }
        else
        {
            <button type="button"
                    class="btn-checkout btn-finalizar boton-finalizar-estadia"
                    disabled
                    data-bs-toggle="modal"
                    data-bs-target="#modalFinalizarConDeuda">
                <i class="bi bi-check-circle"></i> Finalizar estadía
            </button>
        }
    </div>
</div>

@if (!puedeFinalizarDirectamente)
{
    <div class="modal fade" id="modalFinalizarConDeuda" tabindex="-1" aria-labelledby="tituloFinalizarConDeuda" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="tituloFinalizarConDeuda">La cuenta todavía tiene saldo pendiente</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>

                @if (Model.EsAdministrador)
                {
                    <form asp-controller="Reservas" asp-action="FinalizarEstadia" asp-route-id="@Model.IdReserva" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="autorizarSaldoPendiente" value="true" />
                        <input type="hidden" class="valor-requiere-factura" name="requiereFactura" />

                        <div class="modal-body">
                            <div class="alert alert-warning">
                                El saldo pendiente es de <strong>Q @(Model.EsReservaAgrupada ? Model.SaldoPendienteGrupo.ToString("N2") : Model.SaldoPendiente.ToString("N2"))</strong>.
                                Si continúa, la habitación será liberada y la deuda permanecerá en Cuentas por Cobrar.
                            </div>

                            <label for="observacionSalida" class="form-label">Explique por qué se autoriza la salida con deuda</label>
                            <textarea id="observacionSalida"
                                      name="observacionSalida"
                                      class="form-control"
                                      rows="3"
                                      required
                                      maxlength="255"
                                      placeholder="Explicación obligatoria"></textarea>
                        </div>

                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Continuar cobrando</button>
                            <button type="submit" class="btn btn-success boton-finalizar-estadia" disabled onclick="return confirm('¿Confirma que desea finalizar esta estadía con deuda pendiente?');">
                                <span class="texto-finalizar">Autorizar y finalizar con deuda</span>
                            </button>
                        </div>
                    </form>
                }
                else
                {
                    <div class="modal-body">
                        <div class="alert alert-warning mb-0">
                            La cuenta tiene un saldo pendiente de <strong>Q @(Model.EsReservaAgrupada ? Model.SaldoPendienteGrupo.ToString("N2") : Model.SaldoPendiente.ToString("N2"))</strong>.
                            Registre el pago para finalizar la estadía. Si el huésped debe retirarse con deuda, solicite autorización administrativa.
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Continuar cobrando</button>
                    </div>
                }
            </div>
        </div>
    </div>
}

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const opciones = document.querySelectorAll(".decision-factura-opcion");
            const valores = document.querySelectorAll(".valor-requiere-factura");
            const botones = document.querySelectorAll(".boton-finalizar-estadia");
            const textos = document.querySelectorAll(".texto-finalizar");
            const aviso = document.getElementById("avisoDecisionFactura");

            function actualizarDecision(valor) {
                valores.forEach(campo => campo.value = valor);
                botones.forEach(boton => boton.disabled = false);
                textos.forEach(texto => {
                    texto.textContent = valor === "true"
                        ? "Registrar salida y enviar a facturación"
                        : "Finalizar estadía";
                });
                if (aviso) {
                    aviso.textContent = valor === "true"
                        ? "La estadía aparecerá en Facturas pendientes; la habitación se liberará normalmente."
                        : "La estadía no generará trabajo pendiente de facturación.";
                }
            }

            opciones.forEach(opcion => opcion.addEventListener("change", function () {
                actualizarDecision(this.value);
            }));
        });
    </script>
}
