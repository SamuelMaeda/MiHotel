@model MiHotel.Models.ReservaFormViewModel
@using System.Text.Json

@{
    ViewData["Title"] = "Nueva Reserva";
    var clientes = ViewBag.Clientes as List<dynamic> ?? new List<dynamic>();
    var habitaciones = ViewBag.Habitaciones as List<dynamic> ?? new List<dynamic>();
    bool esClienteSesion = ViewBag.EsClienteSesion != null && (bool)ViewBag.EsClienteSesion;
    bool bloquearHabitacion = ViewBag.BloquearHabitacion != null && (bool)ViewBag.BloquearHabitacion;
    bool bloquearFechas = ViewBag.BloquearFechas != null && (bool)ViewBag.BloquearFechas;
    string nombreClienteSesion = ViewBag.NombreClienteSesion?.ToString() ?? "";
    string tokenFlujoCliente = ViewBag.TokenFlujoCliente?.ToString() ?? "";

    var clientesJson = JsonSerializer.Serialize(
        clientes.Select(c => new
        {
            id = c.Id,
            nombre = c.Nombre?.ToString() ?? ""
        })
    );
}

<style>
    .tarjeta-contenido {
        background-color: white;
        border-radius: 15px;
        padding: 20px;
        box-shadow: 0 4px 10px rgba(0,0,0,0.10);
    }

    @@media (min-width: 768px) {
        .tarjeta-contenido {
            padding: 25px;
        }
    }

    .btn-guardar {
        background-color: #464482;
        color: white;
        padding: 10px 16px;
        border-radius: 8px;
        border: none;
        text-decoration: none;
        font-weight: 500;
    }

        .btn-guardar:hover {
            background-color: #36366b;
            color: white;
        }

    .btn-volver {
        background-color: #824B44;
        color: white;
        padding: 10px 16px;
        border-radius: 8px;
        text-decoration: none;
        font-weight: 500;
        display: inline-block;
    }

        .btn-volver:hover {
            background-color: #6e3f39;
            color: white;
        }

    .btn-cliente {
        background-color: transparent;
        color: #464482;
        border: 1px solid #464482;
        padding: 8px 12px;
        border-radius: 8px;
        text-decoration: none;
        font-weight: 500;
        display: inline-block;
    }

        .btn-cliente:hover {
            background-color: #464482;
            color: white;
        }

    .acciones-formulario {
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
        margin-top: 20px;
    }

    .campo-solo-lectura {
        background-color: #f8f9fa;
    }

    .contenedor-autocomplete {
        position: relative;
    }

    .lista-sugerencias {
        position: absolute;
        top: 100%;
        left: 0;
        right: 0;
        z-index: 20;
        background-color: white;
        border: 1px solid #ced4da;
        border-top: none;
        border-radius: 0 0 8px 8px;
        box-shadow: 0 4px 10px rgba(0,0,0,0.08);
        max-height: 220px;
        overflow-y: auto;
        display: none;
    }

    .item-sugerencia {
        padding: 10px 12px;
        cursor: pointer;
        border-bottom: 1px solid #f1f1f1;
    }

        .item-sugerencia:hover,
        .item-sugerencia.activo {
            background-color: #f8f9fa;
        }

        .item-sugerencia:last-child {
            border-bottom: none;
        }

    .texto-sin-resultados {
        padding: 10px 12px;
        color: #6c757d;
    }

    .selector-tipo-reserva {
        background-color: #f8f5f4;
        border: 1px solid #e6d3d0;
        border-radius: 10px;
        padding: 14px 16px;
    }

    .panel-fechas-separadas {
        background-color: #fafafa;
        border: 1px solid #dee2e6;
        border-radius: 10px;
        padding: 16px;
    }

    .fecha-separada-fila {
        display: flex;
        align-items: center;
        gap: 10px;
        margin-bottom: 10px;
    }

    .btn-agregar-fecha,
    .btn-quitar-fecha {
        border: none;
        border-radius: 8px;
        color: white;
        font-weight: 500;
    }

    .btn-agregar-fecha {
        background-color: #198754;
        padding: 9px 14px;
    }

    .btn-quitar-fecha {
        background-color: #824B44;
        min-width: 40px;
        height: 40px;
    }

    .nota-fechas {
        color: #6c757d;
        font-size: 0.92rem;
        margin-bottom: 12px;
    }
</style>

<div class="container-fluid px-3 px-md-4 py-4">
    <div class="row justify-content-center">
        <div class="col-12 col-xl-10">
            <div class="tarjeta-contenido">
                <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
                    <h3 class="m-0">Nueva Reserva</h3>
                </div>

                @if (ViewBag.Mensaje != null)
                {
                    <div class="alert alert-danger">@ViewBag.Mensaje</div>
                }

                @if (TempData["Exito"] != null)
                {
                    <div class="alert alert-success">@TempData["Exito"]</div>
                }

                <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                <form asp-controller="Reservas" asp-action="Crear" method="post" id="formReserva">
                    @Html.AntiForgeryToken()

                    <input asp-for="IdClipro" type="hidden" id="IdClipro" />

                    @if (esClienteSesion && !string.IsNullOrWhiteSpace(tokenFlujoCliente))
                    {
                        <input type="hidden" name="tokenFlujoCliente" value="@tokenFlujoCliente" />
                    }

                    <div class="row">
                        @if (esClienteSesion)
                        {
                            <div class="col-12 col-lg-6 mb-3">
                                <label class="form-label">Cliente</label>
                                <input type="text"
                                       class="form-control campo-solo-lectura"
                                       value="@nombreClienteSesion"
                                       readonly />
                                <span asp-validation-for="IdClipro" class="text-danger"></span>
                            </div>
                        }
                        else
                        {
                            <div class="col-12 col-lg-6 mb-3">
                                <div class="d-flex justify-content-between align-items-center mb-2 flex-wrap gap-2">
                                    <label class="form-label m-0">Cliente</label>
                                    <a href="#" id="btnRegistrarCliente" class="btn-cliente">
                                        Registrar Cliente
                                    </a>
                                </div>

                                <div class="contenedor-autocomplete">
                                    <input type="text"
                                           id="clienteBusqueda"
                                           class="form-control"
                                           placeholder="Escriba para buscar un cliente..."
                                           autocomplete="off" />

                                    <div id="listaClientes" class="lista-sugerencias"></div>
                                </div>

                                <span asp-validation-for="IdClipro" class="text-danger"></span>
                            </div>
                        }

                        <div class="col-12 col-lg-6 mb-3">
                            <label asp-for="IdHabitacion" class="form-label">Habitación</label>

                            @if (bloquearHabitacion)
                            {
                                <input asp-for="IdHabitacion" type="hidden" />

                                <select class="form-select campo-solo-lectura" id="selectHabitacion" disabled>
                                    <option value="">Seleccione una habitación</option>
                                    @foreach (var habitacion in habitaciones)
                                    {
                                        if (Model.IdHabitacion == habitacion.Id)
                                        {
                                            <option value="@habitacion.Id"
                                                    data-precio="@habitacion.Precio"
                                                    data-tipo="@habitacion.Tipo"
                                                    selected>
                                                Habitación @habitacion.Codigo
                                            </option>
                                        }
                                        else
                                        {
                                            <option value="@habitacion.Id"
                                                    data-precio="@habitacion.Precio"
                                                    data-tipo="@habitacion.Tipo">
                                                Habitación @habitacion.Codigo
                                            </option>
                                        }
                                    }
                                </select>
                            }
                            else
                            {
                                <select asp-for="IdHabitacion" class="form-select" id="selectHabitacion">
                                    <option value="">Seleccione una habitación</option>
                                    @foreach (var habitacion in habitaciones)
                                    {
                                        <option value="@habitacion.Id"
                                                data-precio="@habitacion.Precio"
                                                data-tipo="@habitacion.Tipo">
                                            Habitación @habitacion.Codigo
                                        </option>
                                    }
                                </select>
                            }

                            <span asp-validation-for="IdHabitacion" class="text-danger"></span>
                        </div>

                        <div class="col-12 col-md-6 mb-3">
                            <label class="form-label">Tipo de habitación</label>
                            <input type="text" id="tipoHabitacion" class="form-control campo-solo-lectura" readonly />
                        </div>

                        <div class="col-12 col-md-6 mb-3">
                            <label class="form-label">Precio por persona y noche</label>
                            <input type="text" id="precioHabitacion" class="form-control campo-solo-lectura" readonly />
                        </div>

                        <div class="col-12 col-md-6 mb-3">
                            <label class="form-label">Total estimado de hospedaje</label>
                            <input type="text" id="totalReservaEstimado" class="form-control campo-solo-lectura" readonly />
                        </div>

                        @if (!esClienteSesion)
                        {
                            <div class="col-12 mb-3">
                                <div class="selector-tipo-reserva">
                                    <div class="form-check">
                                        <input asp-for="UsarFechasSeparadas" class="form-check-input" id="UsarFechasSeparadas" />
                                        <label asp-for="UsarFechasSeparadas" class="form-check-label fw-semibold">
                                            El huésped se hospedará en fechas separadas
                                        </label>
                                    </div>
                                    <div class="nota-fechas mb-0 mt-1">
                                        Cada fecha representa una noche. Entre fechas puede haber como máximo uno o dos días intermedios.
                                    </div>
                                </div>
                            </div>

                            <div class="col-12 mb-3" id="panelFechasSeparadas" style="display: none;">
                                <div class="panel-fechas-separadas">
                                    <label class="form-label fw-semibold">Fechas de hospedaje</label>
                                    <div class="nota-fechas">Todas las fechas utilizarán la habitación seleccionada.</div>

                                    <div id="listaFechasSeparadas">
                                        @foreach (DateTime fecha in Model.FechasSeparadas)
                                        {
                                            <div class="fecha-separada-fila">
                                                <input type="date"
                                                       name="FechasSeparadas"
                                                       value="@fecha.ToString("yyyy-MM-dd")"
                                                       class="form-control fecha-separada-input" />
                                                <button type="button" class="btn-quitar-fecha" title="Quitar fecha">
                                                    <i class="bi bi-trash-fill"></i>
                                                </button>
                                            </div>
                                        }
                                    </div>

                                    <button type="button" id="btnAgregarFecha" class="btn-agregar-fecha">
                                        <i class="bi bi-plus-lg"></i> Agregar fecha
                                    </button>
                                </div>
                            </div>
                        }

                        <div class="col-12 col-md-6 col-lg-4 mb-3 campo-periodo-continuo">
                            <label asp-for="FechaEntrada" class="form-label">Fecha de entrada</label>

                            @if (bloquearFechas)
                            {
                                <input asp-for="FechaEntrada" type="hidden" id="FechaEntrada" />
                                <input type="date"
                                       class="form-control campo-solo-lectura"
                                       value="@Model.FechaEntrada.ToString("yyyy-MM-dd")"
                                       disabled />
                            }
                            else
                            {
                                <input asp-for="FechaEntrada" type="date" class="form-control" id="FechaEntrada" />
                            }

                            <span asp-validation-for="FechaEntrada" class="text-danger"></span>
                        </div>

                        <div class="col-12 col-md-6 col-lg-4 mb-3 campo-periodo-continuo">
                            <label asp-for="FechaSalida" class="form-label">Fecha de salida</label>

                            @if (bloquearFechas)
                            {
                                <input asp-for="FechaSalida" type="hidden" id="FechaSalida" />
                                <input type="date"
                                       class="form-control campo-solo-lectura"
                                       value="@Model.FechaSalida.ToString("yyyy-MM-dd")"
                                       disabled />
                            }
                            else
                            {
                                <input asp-for="FechaSalida" type="date" class="form-control" id="FechaSalida" />
                            }

                            <span asp-validation-for="FechaSalida" class="text-danger"></span>
                        </div>

                        <div class="col-12 col-md-6 col-lg-4 mb-3">
                            <label asp-for="CantidadPersonas" class="form-label">Cantidad de personas</label>
                            <input asp-for="CantidadPersonas" class="form-control" min="1" id="CantidadPersonas" />
                            <span asp-validation-for="CantidadPersonas" class="text-danger"></span>
                        </div>

                        <div class="col-12 mb-3">
                            <label asp-for="Observaciones" class="form-label">Observaciones</label>
                            <textarea asp-for="Observaciones" class="form-control" rows="4" id="Observaciones"></textarea>
                            <span asp-validation-for="Observaciones" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="acciones-formulario">
                        <button type="submit" class="btn-guardar">Guardar reserva</button>

                        @if (esClienteSesion)
                        {
                            <a asp-controller="Disponibilidad" asp-action="Index" class="btn-volver">Volver a disponibilidad</a>
                        }
                        else
                        {
                            <a asp-controller="Reservas" asp-action="Index" class="btn-volver">Volver al listado</a>
                        }
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const esClienteSesion = @Html.Raw(esClienteSesion.ToString().ToLower());
            const clientes = @Html.Raw(clientesJson);

            const inputCliente = document.getElementById("clienteBusqueda");
            const hiddenIdClipro = document.getElementById("IdClipro");
            const listaClientes = document.getElementById("listaClientes");

            const selectHabitacion = document.getElementById("selectHabitacion");
            const precioHabitacion = document.getElementById("precioHabitacion");
            const tipoHabitacion = document.getElementById("tipoHabitacion");
            const totalReservaEstimado = document.getElementById("totalReservaEstimado");

            const btnRegistrarCliente = document.getElementById("btnRegistrarCliente");
            const urlBaseCrearCliente = "@Url.Action("Crear", "Clientes")";

            const fechaEntradaElement = document.getElementById("FechaEntrada");
            const fechaSalidaElement = document.getElementById("FechaSalida");
            const cantidadPersonasElement = document.getElementById("CantidadPersonas");
            const observacionesElement = document.getElementById("Observaciones");
            const formReserva = document.getElementById("formReserva");
            const usarFechasSeparadasElement = document.getElementById("UsarFechasSeparadas");
            const panelFechasSeparadas = document.getElementById("panelFechasSeparadas");
            const listaFechasSeparadas = document.getElementById("listaFechasSeparadas");
            const btnAgregarFecha = document.getElementById("btnAgregarFecha");
            const camposPeriodoContinuo = document.querySelectorAll(".campo-periodo-continuo");

            function fechaIso(fecha) {
                const anio = fecha.getFullYear();
                const mes = String(fecha.getMonth() + 1).padStart(2, "0");
                const dia = String(fecha.getDate()).padStart(2, "0");
                return `${anio}-${mes}-${dia}`;
            }

            function crearFilaFecha(valor) {
                if (!listaFechasSeparadas) {
                    return;
                }

                const fila = document.createElement("div");
                fila.className = "fecha-separada-fila";

                const input = document.createElement("input");
                input.type = "date";
                input.name = "FechasSeparadas";
                input.className = "form-control fecha-separada-input";
                input.min = fechaIso(new Date());
                input.value = valor || "";
                input.addEventListener("change", actualizarEnlaceRegistrarCliente);

                const boton = document.createElement("button");
                boton.type = "button";
                boton.className = "btn-quitar-fecha";
                boton.title = "Quitar fecha";
                boton.innerHTML = '<i class="bi bi-trash-fill"></i>';
                boton.addEventListener("click", function () {
                    fila.remove();
                    actualizarEnlaceRegistrarCliente();
                });

                fila.appendChild(input);
                fila.appendChild(boton);
                listaFechasSeparadas.appendChild(fila);
            }

            function prepararBotonesQuitarFecha() {
                document.querySelectorAll(".fecha-separada-fila").forEach(function (fila) {
                    const boton = fila.querySelector(".btn-quitar-fecha");
                    const input = fila.querySelector(".fecha-separada-input");

                    if (input) {
                        input.min = fechaIso(new Date());
                        input.addEventListener("change", actualizarEnlaceRegistrarCliente);
                    }

                    if (boton) {
                        boton.addEventListener("click", function () {
                            fila.remove();
                            actualizarEnlaceRegistrarCliente();
                        });
                    }
                });
            }

            function actualizarModoFechas() {
                if (!usarFechasSeparadasElement || !panelFechasSeparadas) {
                    return;
                }

                const esAgrupada = usarFechasSeparadasElement.checked;
                panelFechasSeparadas.style.display = esAgrupada ? "block" : "none";

                camposPeriodoContinuo.forEach(function (campo) {
                    campo.style.display = esAgrupada ? "none" : "block";
                });

                if (esAgrupada && listaFechasSeparadas && listaFechasSeparadas.children.length === 0) {
                    const fechaInicial = fechaEntradaElement && fechaEntradaElement.value
                        ? new Date(fechaEntradaElement.value + "T00:00:00")
                        : new Date();
                    const segundaFecha = new Date(fechaInicial);
                    segundaFecha.setDate(segundaFecha.getDate() + 2);

                    crearFilaFecha(fechaIso(fechaInicial));
                    crearFilaFecha(fechaIso(segundaFecha));
                }

                actualizarEnlaceRegistrarCliente();
            }

            function limpiarListaClientes() {
                if (!listaClientes) {
                    return;
                }

                listaClientes.innerHTML = "";
                listaClientes.style.display = "none";
            }

            function mostrarSugerencias(texto) {
                if (!listaClientes) {
                    return;
                }

                listaClientes.innerHTML = "";

                const textoNormalizado = texto.trim().toLowerCase();

                if (textoNormalizado === "") {
                    limpiarListaClientes();
                    return;
                }

                const coincidencias = clientes.filter(function (c) {
                    return c.nombre.toLowerCase().includes(textoNormalizado);
                });

                if (coincidencias.length === 0) {
                    const sinResultados = document.createElement("div");
                    sinResultados.className = "texto-sin-resultados";
                    sinResultados.textContent = "No se encontraron clientes.";
                    listaClientes.appendChild(sinResultados);
                    listaClientes.style.display = "block";
                    return;
                }

                coincidencias.forEach(function (cliente) {
                    const item = document.createElement("div");
                    item.className = "item-sugerencia";
                    item.textContent = cliente.nombre;

                    item.addEventListener("click", function () {
                        if (inputCliente) {
                            inputCliente.value = cliente.nombre;
                        }

                        hiddenIdClipro.value = cliente.id;
                        limpiarListaClientes();
                        actualizarEnlaceRegistrarCliente();
                    });

                    listaClientes.appendChild(item);
                });

                listaClientes.style.display = "block";
            }

            function actualizarDatosHabitacion() {
                if (!selectHabitacion) {
                    return;
                }

                const opcionSeleccionada = selectHabitacion.options[selectHabitacion.selectedIndex];
                const precio = opcionSeleccionada ? opcionSeleccionada.getAttribute("data-precio") : null;
                const tipo = opcionSeleccionada ? opcionSeleccionada.getAttribute("data-tipo") : null;

                precioHabitacion.value = precio ? "Q " + parseFloat(precio).toFixed(2) : "";
                tipoHabitacion.value = tipo ? tipo : "";
                actualizarTotalEstimado();
            }

            function actualizarTotalEstimado() {
                if (!selectHabitacion || !totalReservaEstimado) {
                    return;
                }

                const opcionSeleccionada = selectHabitacion.options[selectHabitacion.selectedIndex];
                const precio = Number.parseFloat(opcionSeleccionada?.getAttribute("data-precio")) || 0;
                const personas = Math.max(1, Number.parseInt(cantidadPersonasElement?.value || "1", 10));
                let noches = 0;

                if (usarFechasSeparadasElement?.checked) {
                    noches = Array.from(document.querySelectorAll(".fecha-separada-input"))
                        .filter(function (input) { return input.value; })
                        .length;
                }
                else if (fechaEntradaElement?.value && fechaSalidaElement?.value) {
                    const entrada = new Date(fechaEntradaElement.value + "T00:00:00");
                    const salida = new Date(fechaSalidaElement.value + "T00:00:00");
                    noches = Math.max(0, Math.round((salida - entrada) / 86400000));
                }

                totalReservaEstimado.value = precio > 0 && noches > 0
                    ? "Q " + (precio * personas * noches).toFixed(2)
                    : "";
            }

            function cargarClienteSeleccionadoInicial() {
                if (esClienteSesion || !inputCliente) {
                    return;
                }

                const idClienteActual = hiddenIdClipro.value;

                if (!idClienteActual) {
                    return;
                }

                const clienteSeleccionado = clientes.find(function (c) {
                    return c.id.toString() === idClienteActual.toString();
                });

                if (clienteSeleccionado) {
                    inputCliente.value = clienteSeleccionado.nombre;
                }
            }

            function actualizarEnlaceRegistrarCliente() {
                if (!btnRegistrarCliente || esClienteSesion) {
                    return;
                }

                const params = new URLSearchParams();

                const idHabitacion = selectHabitacion ? selectHabitacion.value : "";
                const fechaEntrada = fechaEntradaElement ? fechaEntradaElement.value : "";
                const fechaSalida = fechaSalidaElement ? fechaSalidaElement.value : "";
                const cantidadPersonas = cantidadPersonasElement ? cantidadPersonasElement.value : "";
                const observaciones = observacionesElement ? observacionesElement.value : "";

                if (idHabitacion) {
                    params.append("idHabitacion", idHabitacion);
                }

                if (fechaEntrada) {
                    params.append("fechaEntrada", fechaEntrada);
                }

                if (fechaSalida) {
                    params.append("fechaSalida", fechaSalida);
                }

                if (cantidadPersonas) {
                    params.append("cantidadPersonas", cantidadPersonas);
                }

                if (observaciones) {
                    params.append("observaciones", observaciones);
                }

                if (usarFechasSeparadasElement && usarFechasSeparadasElement.checked) {
                    params.append("usarFechasSeparadas", "true");

                    document.querySelectorAll(".fecha-separada-input").forEach(function (input) {
                        if (input.value) {
                            params.append("fechasSeparadas", input.value);
                        }
                    });
                }

                const returnUrl = "/Reservas/Crear" + (params.toString() ? "?" + params.toString() : "");
                const hrefFinal = urlBaseCrearCliente + "?returnUrl=" + encodeURIComponent(returnUrl);

                btnRegistrarCliente.setAttribute("href", hrefFinal);
            }

            if (inputCliente) {
                inputCliente.addEventListener("input", function () {
                    hiddenIdClipro.value = "";
                    mostrarSugerencias(inputCliente.value);
                    actualizarEnlaceRegistrarCliente();
                });

                inputCliente.addEventListener("focus", function () {
                    if (inputCliente.value.trim() !== "") {
                        mostrarSugerencias(inputCliente.value);
                    }
                });
            }

            document.addEventListener("click", function (e) {
                if (!listaClientes || !inputCliente) {
                    return;
                }

                if (!listaClientes.contains(e.target) && e.target !== inputCliente) {
                    limpiarListaClientes();
                }
            });

            if (selectHabitacion) {
                selectHabitacion.addEventListener("change", function () {
                    actualizarDatosHabitacion();
                    actualizarEnlaceRegistrarCliente();
                });
            }

            if (fechaEntradaElement && !esClienteSesion) {
                fechaEntradaElement.addEventListener("change", function () {
                    actualizarEnlaceRegistrarCliente();
                    actualizarTotalEstimado();
                });
            }

            if (fechaSalidaElement && !esClienteSesion) {
                fechaSalidaElement.addEventListener("change", function () {
                    actualizarEnlaceRegistrarCliente();
                    actualizarTotalEstimado();
                });
            }

            if (cantidadPersonasElement) {
                cantidadPersonasElement.addEventListener("input", function () {
                    actualizarEnlaceRegistrarCliente();
                    actualizarTotalEstimado();
                });
            }

            if (observacionesElement) {
                observacionesElement.addEventListener("input", actualizarEnlaceRegistrarCliente);
            }

            if (usarFechasSeparadasElement) {
                usarFechasSeparadasElement.addEventListener("change", function () {
                    actualizarModoFechas();
                    actualizarTotalEstimado();
                });
            }

            listaFechasSeparadas?.addEventListener("change", actualizarTotalEstimado);
            listaFechasSeparadas?.addEventListener("click", function () {
                window.setTimeout(actualizarTotalEstimado, 0);
            });

            if (btnAgregarFecha) {
                btnAgregarFecha.addEventListener("click", function () {
                    crearFilaFecha("");
                    actualizarEnlaceRegistrarCliente();
                    actualizarTotalEstimado();
                });
            }

            if (formReserva) {
                formReserva.addEventListener("submit", function (event) {
                    if (!usarFechasSeparadasElement || !usarFechasSeparadasElement.checked) {
                        return;
                    }

                    document.querySelectorAll(".fecha-separada-input").forEach(function (input) {
                        if (!input.value) {
                            input.closest(".fecha-separada-fila")?.remove();
                        }
                    });

                    const fechasCompletas = Array.from(document.querySelectorAll(".fecha-separada-input"))
                        .filter(function (input) { return input.value; });

                    if (fechasCompletas.length < 2) {
                        event.preventDefault();
                        alert("Seleccione al menos dos fechas para la reserva agrupada.");
                    }
                });
            }

            prepararBotonesQuitarFecha();
            cargarClienteSeleccionadoInicial();
            actualizarDatosHabitacion();
            actualizarModoFechas();
            actualizarEnlaceRegistrarCliente();
        });
    </script>
}
