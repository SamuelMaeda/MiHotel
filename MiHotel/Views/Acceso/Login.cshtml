@model MiHotel.Models.InicioSesion

@{
    ViewData["Title"] = "Iniciar Sesión";
    Layout = null;

    string nombreEmpresa = ViewBag.EmpresaNombre ?? "MiHotel";
    string logoEmpresa = ViewBag.EmpresaLogo ?? "logo.png";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Login - @nombreEmpresa</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/bootstrap-icons.min.css" />
    <style>
        body {
            background-color: #824B44;
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 20px;
        }

        .contenedor-login {
            background-color: #fff;
            border: 1px solid rgba(130,75,68,.10);
            border-radius: 16px;
            box-shadow: 0 8px 22px rgba(71,71,71,.14);
            padding: 30px;
            width: 100%;
            max-width: 420px;
            animation: entradaLogin .28s ease-out both;
        }

        .titulo-login {
            color: #292936;
            font-weight: bold;
            text-align: center;
            margin-bottom: 20px;
        }

        .btn-login {
            min-height: 44px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            background-color: #464482;
            border-color: #464482;
            color: white;
            font-weight: 600;
            transition: transform .16s ease, box-shadow .16s ease, background-color .16s ease;
        }

            .btn-login:hover {
                background-color: #36366b;
                border-color: #36366b;
                color: white;
                transform: translateY(-2px);
                box-shadow: 0 5px 11px rgba(71,71,71,.18);
            }

        .mensaje-error {
            color: red;
            text-align: center;
            margin-bottom: 15px;
        }

        .logo-login {
            display: block;
            margin: 0 auto 15px auto;
            max-width: 140px;
            width: 100%;
            height: auto;
        }

        .form-control:focus {
            border-color: #464482;
            box-shadow: 0 0 0 .2rem rgba(70,68,130,.14);
        }

        .campo-clave {
            position: relative;
        }

        .campo-clave .form-control {
            padding-right: 48px;
        }

        .alternar-clave {
            position: absolute;
            top: 50%;
            right: 7px;
            width: 36px;
            height: 36px;
            border: 0;
            border-radius: 7px;
            background: transparent;
            color: #474747;
            transform: translateY(-50%);
        }

        .alternar-clave:hover,
        .alternar-clave:focus-visible {
            background: #f3e9e7;
            color: #824B44;
        }

        @@keyframes entradaLogin {
            from { opacity: 0; transform: translateY(7px); }
            to { opacity: 1; transform: translateY(0); }
        }

        @@media (prefers-reduced-motion: reduce) {
            .contenedor-login, .btn-login { animation: none; transition: none; }
        }

    </style>
</head>
<body>
    <div class="contenedor-login">
        <img src="~/images/@logoEmpresa" alt="@nombreEmpresa" class="logo-login" />

        <h2 class="titulo-login">Iniciar Sesión</h2>

        @if (ViewBag.Mensaje != null)
        {
            <div class="mensaje-error">
                @ViewBag.Mensaje
            </div>
        }

        <form action="/Acceso/Login" method="post">
            @Html.AntiForgeryToken()
            <div class="mb-3">
                <label asp-for="Correo" class="form-label">Correo</label>
                <input asp-for="Correo" class="form-control" />
                <span asp-validation-for="Correo" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Clave" class="form-label">Clave</label>
                <div class="campo-clave">
                    <input asp-for="Clave" class="form-control" type="password" />
                    <button type="button" id="alternarClave" class="alternar-clave" title="Mostrar contraseña" aria-label="Mostrar contraseña" aria-pressed="false">
                        <i class="bi bi-eye-fill" aria-hidden="true"></i>
                    </button>
                </div>
                <span asp-validation-for="Clave" class="text-danger"></span>
            </div>

            <div class="d-grid">
                <button type="submit" class="btn btn-login"><i class="bi bi-box-arrow-in-right" aria-hidden="true"></i> Ingresar</button>
            </div>
        </form>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.getElementById("alternarClave")?.addEventListener("click", function () {
            const campo = document.getElementById("Clave");
            const mostrar = campo.type === "password";
            campo.type = mostrar ? "text" : "password";
            this.title = mostrar ? "Ocultar contraseña" : "Mostrar contraseña";
            this.setAttribute("aria-label", this.title);
            this.setAttribute("aria-pressed", mostrar ? "true" : "false");
            this.querySelector("i").className = `bi ${mostrar ? "bi-eye-slash-fill" : "bi-eye-fill"}`;
            campo.focus();
        });
    </script>
</body>
</html>
