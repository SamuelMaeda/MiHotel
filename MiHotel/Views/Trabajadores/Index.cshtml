@model System.Data.DataTable
@{ ViewData["Title"]="Trabajadores"; string vista=ViewBag.Vista??"activos"; string busqueda=ViewBag.Busqueda??""; string ordenar=ViewBag.OrdenarPor??"nombre"; string direccion=ViewBag.Direccion??"asc"; int pagina=ViewBag.PaginaActual??1; int paginas=ViewBag.TotalPaginas??1; int total=ViewBag.TotalRegistros??0; string Dir(string c)=>ordenar==c&&direccion=="asc"?"desc":"asc"; string Icono(string c)=>ordenar!=c?"bi-arrow-down-up":direccion=="asc"?"bi-sort-alpha-down":"bi-sort-alpha-up"; string Tel(object v){string s=v?.ToString()??"";return s.Length==8?s[..4]+" "+s[4..]:s;} }
<style>
    .tarjeta{background:#fff;border-radius:15px;padding:25px;box-shadow:0 4px 10px rgba(0,0,0,.1)}.encabezado{display:flex;justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap}.btn-crear{background:#464482;color:#fff;padding:10px 16px;border-radius:8px;text-decoration:none;font-weight:500}.btn-crear:hover{background:#36366b;color:#fff}.tabs{display:flex;gap:10px;margin:20px 0;flex-wrap:wrap}.tab{background:#e6d3d0;color:#363636;padding:9px 14px;border-radius:8px;text-decoration:none}.tab.activa{background:#824B44;color:#fff}.tabla-scroll{overflow-x:auto}.encabezado-orden{color:inherit;text-decoration:none;white-space:nowrap;display:inline-flex;align-items:center;gap:7px}.encabezado-orden:hover{color:inherit}.acciones{display:flex;gap:7px}.btn-icono{width:38px;height:38px;border:0;border-radius:8px;color:#fff;display:inline-flex;align-items:center;justify-content:center}.editar{background:#824B44}.estado{background:#363636}.observaciones{min-width:240px;white-space:normal}.paginas{display:flex;gap:7px;flex-wrap:wrap;margin-top:18px}.pagina{background:#e6d3d0;color:#363636;padding:7px 11px;border-radius:7px;text-decoration:none}.pagina.activa{background:#464482;color:#fff}
</style>
<div class="tarjeta"><div class="encabezado"><div><h3 class="m-0">Listado de Trabajadores</h3><div class="text-muted">Contactos de trabajadores y personal de servicio.</div></div><a asp-action="Crear" class="btn-crear"><i class="bi bi-person-plus-fill"></i> Nuevo Trabajador</a></div>
@if(ViewBag.Mensaje!=null){<div class="alert alert-danger mt-3">@ViewBag.Mensaje</div>}@if(TempData["Mensaje"]!=null){<div class="alert alert-danger mt-3">@TempData["Mensaje"]</div>}@if(TempData["Exito"]!=null){<div class="alert alert-success mt-3">@TempData["Exito"]</div>}
<div class="tabs"><a asp-route-vista="activos" class="tab @(vista=="activos"?"activa":"")">Activos</a><a asp-route-vista="inactivos" class="tab @(vista=="inactivos"?"activa":"")">Inactivos</a></div>
<form method="get" class="mb-3"><input type="hidden" name="vista" value="@vista"/><div class="input-group"><input name="busqueda" value="@busqueda" class="form-control" placeholder="Buscar por nombre, código, teléfono u observaciones"/><button class="btn btn-dark"><i class="bi bi-search"></i> Buscar</button></div></form>
<div class="mb-2"><strong>Total de registros:</strong> @total</div><div class="tabla-scroll"><table class="table table-striped table-bordered align-middle"><thead class="table-dark"><tr>
<th><a class="encabezado-orden" asp-route-ordenarPor="nombre" asp-route-direccion="@Dir("nombre")" asp-route-vista="@vista" asp-route-busqueda="@busqueda">Nombre <i class="bi @Icono("nombre")"></i></a></th>
<th><a class="encabezado-orden" asp-route-ordenarPor="codigo" asp-route-direccion="@Dir("codigo")" asp-route-vista="@vista" asp-route-busqueda="@busqueda">Código de servicio <i class="bi @Icono("codigo")"></i></a></th>
<th><a class="encabezado-orden" asp-route-ordenarPor="telefono" asp-route-direccion="@Dir("telefono")" asp-route-vista="@vista" asp-route-busqueda="@busqueda">Teléfono <i class="bi @Icono("telefono")"></i></a></th><th><a class="encabezado-orden" asp-route-ordenarPor="observaciones" asp-route-direccion="@Dir("observaciones")" asp-route-vista="@vista" asp-route-busqueda="@busqueda">Observaciones <i class="bi @Icono("observaciones")"></i></a></th><th>Acciones</th></tr></thead><tbody>
@if(Model.Rows.Count==0){<tr><td colspan="5" class="text-center text-muted">No se encontraron trabajadores.</td></tr>}else{@foreach(System.Data.DataRow fila in Model.Rows){<tr><td>@fila["nombre"]</td><td>@(fila["codigo_servicio"]==DBNull.Value?"-":fila["codigo_servicio"])</td><td>@Tel(fila["telefono"])</td><td class="observaciones">@(fila["observaciones"]==DBNull.Value?"-":fila["observaciones"])</td><td><div class="acciones"><a asp-action="Editar" asp-route-id="@fila["id_trabajador"]" class="btn-icono editar" title="Editar"><i class="bi bi-pencil-fill"></i></a><form asp-action="CambiarEstado" method="post">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@fila["id_trabajador"]"/><input type="hidden" name="vista" value="@vista"/><input type="hidden" name="busqueda" value="@busqueda"/><input type="hidden" name="ordenarPor" value="@ordenar"/><input type="hidden" name="direccion" value="@direccion"/><input type="hidden" name="pagina" value="@pagina"/><button class="btn-icono estado" title="Cambiar estado"><i class="bi bi-arrow-repeat"></i></button></form></div></td></tr>}}
</tbody></table></div>@if(paginas>1){<div class="paginas">@for(int i=1;i<=paginas;i++){<a asp-route-pagina="@i" asp-route-vista="@vista" asp-route-busqueda="@busqueda" asp-route-ordenarPor="@ordenar" asp-route-direccion="@direccion" class="pagina @(i==pagina?"activa":"")">@i</a>}</div>}</div>
