@model MiHotel.Models.TrabajadorViewModel
@{ ViewData["Title"] = "Editar Trabajador"; }
<style>
    .tarjeta{background:#fff;border-radius:15px;padding:25px;box-shadow:0 4px 10px rgba(0,0,0,.1);max-width:850px;margin:auto}.texto-opcional{font-size:13px;color:#6c757d}.acciones{display:flex;gap:10px;flex-wrap:wrap;margin-top:18px}.btn-guardar,.btn-volver{color:#fff;border:0;border-radius:8px;padding:10px 17px;text-decoration:none;font-weight:500}.btn-guardar{background:#464482}.btn-guardar:hover{background:#36366b}.btn-volver{background:#824B44}.btn-volver:hover{background:#6e3f39;color:#fff}
</style>
<div class="container-fluid px-3 px-md-4 py-4"><div class="tarjeta"><h3 class="mb-3">Editar Trabajador</h3>
@if(ViewBag.Mensaje!=null){<div class="alert alert-danger">@ViewBag.Mensaje</div>}<div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
<form method="post" novalidate>@Html.AntiForgeryToken()<input asp-for="IdTrabajador" type="hidden"/><input asp-for="Estado" type="hidden"/><partial name="_Formulario" model="Model"/><div class="acciones"><button class="btn-guardar">Guardar cambios</button><a asp-action="Index" class="btn-volver">Volver al listado</a></div></form></div></div>
@section Scripts{<partial name="_ValidationScriptsPartial"/><script>document.querySelectorAll('.campo-telefono').forEach(x=>x.addEventListener('input',()=>{let v=x.value.replace(/\D/g,'').slice(0,8);x.value=v.length>4?v.slice(0,4)+' '+v.slice(4):v;}));</script>}
