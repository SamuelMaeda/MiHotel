@model System.Data.DataTable
@{ViewData["Title"]="Empresas de procedencia";string vista=ViewBag.Vista??"activos";}
<style>.tarjeta{background:#fff;border-radius:15px;padding:25px;box-shadow:0 4px 10px rgba(0,0,0,.1)}.btn-nuevo,.btn-volver{color:#fff;text-decoration:none;border-radius:8px;padding:10px 15px}.btn-nuevo{background:#464482}.btn-volver{background:#824B44}.tabs{display:flex;gap:10px;margin:20px 0}.tab{background:#e6d3d0;color:#363636;padding:9px 14px;border-radius:8px;text-decoration:none}.tab.activa{background:#824B44;color:#fff}.btn-icono{border:0;color:#fff;border-radius:8px;width:38px;height:38px}.editar{background:#824B44}.estado{background:#363636}</style>
<div class="tarjeta"><div class="d-flex justify-content-between align-items-center flex-wrap gap-2"><div><h3 class="m-0">Empresas de procedencia</h3><div class="text-muted">Catálogo utilizado exclusivamente para identificar de qué empresa vienen los huéspedes.</div></div><div class="d-flex gap-2"><a asp-controller="Clientes" asp-action="Index" class="btn-volver">Volver a clientes</a><a asp-action="Crear" class="btn-nuevo">Nueva empresa</a></div></div>
@if(ViewBag.Mensaje!=null){<div class="alert alert-danger mt-3">@ViewBag.Mensaje</div>}@if(TempData["Exito"]!=null){<div class="alert alert-success mt-3">@TempData["Exito"]</div>}
<div class="tabs"><a asp-route-vista="activos" class="tab @(vista=="activos"?"activa":"")">Activas</a><a asp-route-vista="inactivos" class="tab @(vista=="inactivos"?"activa":"")">Inactivas</a></div>
<table class="table table-striped table-bordered align-middle"><thead class="table-dark"><tr><th>Empresa de procedencia</th><th>Clientes asociados</th><th>Acciones</th></tr></thead><tbody>
@foreach(System.Data.DataRow fila in Model.Rows){<tr><td>@fila["nombre"]</td><td>@fila["total_clientes"]</td><td><div class="d-flex gap-2"><a asp-action="Editar" asp-route-id="@fila["id_empresa_cliente"]" class="btn-icono editar d-inline-flex align-items-center justify-content-center"><i class="bi bi-pencil-fill"></i></a><form asp-action="CambiarEstado" method="post">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@fila["id_empresa_cliente"]"/><button class="btn-icono estado"><i class="bi bi-arrow-repeat"></i></button></form></div></td></tr>}
</tbody></table></div>
