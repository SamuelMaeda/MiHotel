@model MiHotel.Models.CuentaPorPagarFormViewModel
@{
    ViewData["Title"] = "Editar cuenta por pagar";
}

<div class="tarjeta mh-page-shell mh-page-shell--form">
    <div class="mh-page-header">
        <div>
            <h3>Editar cuenta por pagar</h3>
            <p>Los cambios de monto se aplicarán a las mensualidades futuras.</p>
        </div>
    </div>

    @if (ViewBag.Mensaje != null)
    {
        <div class="alert alert-danger">@ViewBag.Mensaje</div>
    }

    <form asp-action="Editar" method="post" novalidate>
        @Html.AntiForgeryToken()
        <input asp-for="IdCuentaPorPagar" type="hidden" />
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <div class="mb-3">
            <label asp-for="Nombre" class="form-label"></label>
            <input asp-for="Nombre" class="form-control" maxlength="150" />
            <span asp-validation-for="Nombre" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="TipoMonto" class="form-label"></label>
            <select asp-for="TipoMonto" class="form-select" id="tipoMonto">
                <option value="fijo">Fijo — conserva el mismo importe cada mes</option>
                <option value="variable">Variable — el importe se ingresa al recibir el recibo</option>
            </select>
            <span asp-validation-for="TipoMonto" class="text-danger"></span>
        </div>

        <div class="row g-3">
            <div class="col-md-7" id="montoMensualContenedor">
                <label asp-for="MontoMensual" class="form-label"></label>
                <div class="input-group">
                    <span class="input-group-text">Q</span>
                    <input asp-for="MontoMensual" class="form-control" type="number" min="0.01" step="0.01" />
                </div>
                <span asp-validation-for="MontoMensual" class="text-danger"></span>
            </div>
            <div class="col-md-5">
                <label asp-for="DiaVencimiento" class="form-label"></label>
                <input asp-for="DiaVencimiento" class="form-control" type="number" min="1" max="28" />
                <span asp-validation-for="DiaVencimiento" class="text-danger"></span>
                <div class="form-text">Se limita al día 28 para que exista en todos los meses.</div>
            </div>
        </div>

        <div class="mt-3">
            <label asp-for="Descripcion" class="form-label"></label>
            <textarea asp-for="Descripcion" class="form-control" rows="5" maxlength="1000"></textarea>
            <span asp-validation-for="Descripcion" class="text-danger"></span>
        </div>

        <div class="alert alert-light border mt-3 mb-0">
            Las deudas ya generadas conservarán el monto con el que fueron creadas.
        </div>

        <div class="mh-bottom-actions">
            <a asp-action="Index" class="mh-btn mh-btn-back">
                <i class="bi bi-arrow-left-circle-fill" aria-hidden="true"></i> Volver al listado
            </a>
            <button type="submit" class="mh-btn mh-btn-primary">
                <i class="bi bi-floppy-fill" aria-hidden="true"></i> Guardar cambios
            </button>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (() => {
            const tipo = document.getElementById("tipoMonto");
            const contenedor = document.getElementById("montoMensualContenedor");
            const monto = document.getElementById("MontoMensual");
            const actualizar = () => {
                const variable = tipo.value === "variable";
                contenedor.hidden = variable;
                monto.disabled = variable;
            };
            tipo.addEventListener("change", actualizar);
            actualizar();
        })();
    </script>
}
