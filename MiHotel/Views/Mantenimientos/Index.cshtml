@model System.Data.DataTable
@{ ViewData["Title"]="Mantenimientos"; string vista=ViewBag.Vista??"pendientes"; string busqueda=ViewBag.Busqueda??""; string ordenar=ViewBag.OrdenarPor??"fecha"; string direccion=ViewBag.Direccion??"desc"; int pagina=ViewBag.PaginaActual??1; int paginas=ViewBag.TotalPaginas??1; int total=ViewBag.TotalRegistros??0; string Dir(string c)=>ordenar==c&&direccion=="asc"?"desc":"asc"; string Icono(string c)=>ordenar!=c?"bi-arrow-down-up":direccion=="asc"?"bi-sort-down-alt":"bi-sort-up"; string Fecha(object v)=>v==DBNull.Value?"-":Convert.ToDateTime(v).ToString("dd/MM/yyyy HH:mm"); }
<style>
.tarjeta{background:#fff;border-radius:15px;padding:25px;box-shadow:0 4px 10px rgba(0,0,0,.1)}.encabezado{display:flex;justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap}.btn-crear{background:#464482;color:#fff;padding:10px 16px;border-radius:8px;text-decoration:none;font-weight:500}.btn-crear:hover{background:#36366b;color:#fff}.tabs{display:flex;gap:10px;margin:20px 0;flex-wrap:wrap}.tab{background:#e6d3d0;color:#363636;padding:10px 14px;border-radius:8px;text-decoration:none;font-weight:500}.tab.activa{background:#824B44;color:#fff}.contador{display:inline-flex;min-width:25px;height:25px;padding:0 7px;align-items:center;justify-content:center;border-radius:999px;background:rgba(255,255,255,.25);font-size:13px}.tabla-scroll{overflow-x:auto}.encabezado-orden{color:inherit;text-decoration:none;white-space:nowrap;display:inline-flex;align-items:center;gap:7px}.encabezado-orden:hover{color:inherit}.descripcion{min-width:380px;white-space:pre-wrap}.acciones{display:flex;gap:7px}.btn-icono{width:40px;height:40px;border:0;border-radius:8px;color:#fff;display:inline-flex;align-items:center;justify-content:center}.editar{background:#824B44}.completar{background:#277a48}.paginas{display:flex;gap:7px;flex-wrap:wrap;margin-top:18px}.pagina{background:#e6d3d0;color:#363636;padding:7px 11px;border-radius:7px;text-decoration:none}.pagina.activa{background:#464482;color:#fff}
</style>
<div class="tarjeta"><div class="encabezado"><div><h3 class="m-0">Mantenimientos</h3><div class="text-muted">Lista de mantenimientos pendientes e historial de trabajos completados.</div></div><a asp-action="Crear" class="btn-crear"><i class="bi bi-tools"></i> Nuevo Mantenimiento</a></div>
@if(ViewBag.Mensaje!=null){<div class="alert alert-danger mt-3">@ViewBag.Mensaje</div>}@if(TempData["Mensaje"]!=null){<div class="alert alert-danger mt-3">@TempData["Mensaje"]</div>}@if(TempData["Exito"]!=null){<div class="alert alert-success mt-3">@TempData["Exito"]</div>}
<div class="tabs"><a asp-route-vista="pendientes" class="tab @(vista=="pendientes"?"activa":"")"><i class="bi bi-list-task"></i> Pendientes @if(vista=="pendientes"){<span class="contador">@total</span>}</a><a asp-route-vista="historial" class="tab @(vista=="historial"?"activa":"")"><i class="bi bi-clock-history"></i> Historial @if(vista=="historial"){<span class="contador">@total</span>}</a></div>
<form method="get" class="mb-3"><input type="hidden" name="vista" value="@vista"/><div class="input-group"><input name="busqueda" value="@busqueda" class="form-control" placeholder="Buscar por nombre o descripción"/><button class="btn btn-dark"><i class="bi bi-search"></i> Buscar</button></div></form>
<div class="mb-2"><strong>Total de registros:</strong> @total</div><div class="tabla-scroll"><table class="table table-striped table-bordered align-middle"><thead class="table-dark"><tr>
<th><a class="encabezado-orden" asp-route-ordenarPor="nombre" asp-route-direccion="@Dir("nombre")" asp-route-vista="@vista" asp-route-busqueda="@busqueda">Nombre <i class="bi @Icono("nombre")"></i></a></th><th><a class="encabezado-orden" asp-route-ordenarPor="descripcion" asp-route-direccion="@Dir("descripcion")" asp-route-vista="@vista" asp-route-busqueda="@busqueda">Descripción <i class="bi @Icono("descripcion")"></i></a></th><th><a class="encabezado-orden" asp-route-ordenarPor="fecha" asp-route-direccion="@Dir("fecha")" asp-route-vista="@vista" asp-route-busqueda="@busqueda">Fecha de registro <i class="bi @Icono("fecha")"></i></a></th>@if(vista=="historial"){<th><a class="encabezado-orden" asp-route-ordenarPor="completado" asp-route-direccion="@Dir("completado")" asp-route-vista="@vista" asp-route-busqueda="@busqueda">Fecha de finalización <i class="bi @Icono("completado")"></i></a></th>}else{<th>Acciones</th>}</tr></thead><tbody>
@if(Model.Rows.Count==0){<tr><td colspan="4" class="text-center text-muted">@(vista=="historial"?"No hay mantenimientos en el historial.":"No hay mantenimientos pendientes.")</td></tr>}else{@foreach(System.Data.DataRow fila in Model.Rows){<tr><td>@fila["nombre"]</td><td class="descripcion">@fila["descripcion"]</td><td>@Fecha(fila["fecha_registro"])</td>@if(vista=="historial"){<td>@Fecha(fila["fecha_completado"])</td>}else{<td><div class="acciones"><a asp-action="Editar" asp-route-id="@fila["id_mantenimiento"]" class="btn-icono editar" title="Editar"><i class="bi bi-pencil-fill"></i></a><form asp-action="Completar" method="post" onsubmit="return confirm('¿Confirma que este mantenimiento ya fue completado?');">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@fila["id_mantenimiento"]"/><input type="hidden" name="busqueda" value="@busqueda"/><input type="hidden" name="ordenarPor" value="@ordenar"/><input type="hidden" name="direccion" value="@direccion"/><input type="hidden" name="pagina" value="@pagina"/><button class="btn-icono completar" title="Marcar como completado"><i class="bi bi-check-lg"></i></button></form></div></td>}</tr>}}
</tbody></table></div>@if(paginas>1){<div class="paginas">@for(int i=1;i<=paginas;i++){<a asp-route-pagina="@i" asp-route-vista="@vista" asp-route-busqueda="@busqueda" asp-route-ordenarPor="@ordenar" asp-route-direccion="@direccion" class="pagina @(i==pagina?"activa":"")">@i</a>}</div>}</div>
