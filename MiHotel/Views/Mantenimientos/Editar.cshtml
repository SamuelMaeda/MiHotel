@model MiHotel.Models.MantenimientoViewModel
@{ ViewData["Title"]="Editar Mantenimiento"; }
<style>.tarjeta{background:#fff;border-radius:15px;padding:25px;box-shadow:0 4px 10px rgba(0,0,0,.1);max-width:850px;margin:auto}.acciones{display:flex;gap:10px;flex-wrap:wrap;margin-top:20px}.btn-guardar,.btn-volver{color:#fff;border:0;border-radius:8px;padding:10px 17px;text-decoration:none;font-weight:500}.btn-guardar{background:#464482}.btn-guardar:hover{background:#36366b}.btn-volver{background:#824B44}.btn-volver:hover{background:#6e3f39;color:#fff}</style>
<div class="container-fluid px-3 px-md-4 py-4"><div class="tarjeta"><h3 class="mb-2">Editar Mantenimiento</h3><p class="text-muted">Modifique la información mientras el mantenimiento continúe pendiente.</p>
@if(ViewBag.Mensaje!=null){<div class="alert alert-danger">@ViewBag.Mensaje</div>}<div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
<form method="post" novalidate>@Html.AntiForgeryToken()<input asp-for="IdMantenimiento" type="hidden"/><input asp-for="Estado" type="hidden"/><input asp-for="FechaRegistro" type="hidden"/><div class="mb-3"><label asp-for="Nombre" class="form-label">Nombre del mantenimiento</label><input asp-for="Nombre" class="form-control" maxlength="150"/><span asp-validation-for="Nombre" class="text-danger"></span></div><label asp-for="Descripcion" class="form-label">Descripción del mantenimiento</label><textarea asp-for="Descripcion" class="form-control" rows="6" maxlength="1000"></textarea><span asp-validation-for="Descripcion" class="text-danger"></span><div class="form-text">Máximo 1,000 caracteres.</div><div class="acciones"><button class="btn-guardar">Guardar cambios</button><a asp-action="Index" class="btn-volver">Volver al listado</a></div></form></div></div>
@section Scripts{<partial name="_ValidationScriptsPartial"/>}
